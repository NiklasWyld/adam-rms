{% extends "assets/template.twig" %}
{% block content %}
<div class="container-fluid">
    <div class="card" id="room-catalogue">
        <div class="card-header d-flex flex-wrap align-items-center">
            <h2 class="card-title mr-auto">Räume</h2>
            {% if "LOCATIONS:VIEW"|instancePermissions %}<a href="{{ CONFIG.ROOTURL }}/location/" class="btn btn-default btn-sm mr-2">Standorte</a>{% endif %}
            {% if "ROOMS:MANAGE"|instancePermissions %}<button id="room-new" class="btn btn-primary btn-sm">Raum hinzufügen</button>{% endif %}
        </div>
        <div class="card-body">
            <p class="text-muted">Verwalte buchbare Räume. Verknüpfe einen Raum mit einem Standort oder trage das Gebäude direkt ein.</p>
            <div class="rp-toolbar mb-3">
                <label class="sr-only" for="room-catalogue-search">Räume suchen</label><input type="search" class="form-control w-auto" id="room-catalogue-search" placeholder="Räume suchen">
                <label class="sr-only" for="room-active-filter">Raumverfügbarkeit</label><select class="form-control w-auto" id="room-active-filter"><option value="1">Aktive Räume</option><option value="">Alle Räume</option><option value="0">Inaktive Räume</option></select>
            </div>
            <div class="table-responsive"><table class="table table-hover" id="room-catalogue-table">
                <thead><tr><th>Raum</th><th>Gebäude / Standort</th><th>Kapazität</th><th>Beschreibung / Ausstattung / Notizen</th><th>Verfügbarkeit</th><th>Aktionen</th></tr></thead>
                <tbody><tr><td colspan="6">Räume werden geladen …</td></tr></tbody>
            </table></div>
            {% if "ROOMS:MANAGE"|instancePermissions %}
            <form id="room-timezone-form" class="rp-toolbar border-top pt-3 mt-2">
                <label for="room-timezone">Zeitzone für die Planung</label><select id="room-timezone" class="form-control w-auto"></select>
                <button class="btn btn-default" type="submit">Zeitzone speichern</button>
                <small class="text-muted">Beim Wechsel der Zeitzone ändern sich nur die angezeigten Uhrzeiten. Die Buchungszeitpunkte bleiben erhalten.</small>
            </form>
            {% else %}<p class="text-muted">Du kannst Räume ansehen. Zum Anlegen oder Bearbeiten brauchst du Zugriff auf die Raumverwaltung.</p>{% endif %}
        </div>
    </div>
    {% include 'rooms/planner.twig' with {'roomGlobal': true} %}
</div>
{% endblock %}
