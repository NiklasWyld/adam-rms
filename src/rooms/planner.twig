<link rel="stylesheet" href="{{ CONFIG.ROOTURL }}/rooms/planning.css">
<div id="room-planning" data-endpoint="{{ CONFIG.ROOTURL }}/api/rooms/action.php" data-project="{{ roomGlobal ? '' : project.projects_id }}" data-global="{{ roomGlobal ? '1' : '0' }}" data-export="{{ CONFIG.ROOTURL }}/rooms/export.php" data-project-url="{{ CONFIG.ROOTURL }}/project/">
    <div id="room-error" class="alert alert-danger" role="alert" hidden></div>
    <div id="room-status" role="status" aria-live="polite" class="text-muted mb-2">Raumplanung wird geladen …</div>
    <div id="room-planner-content" {% if roomGlobal and not ("PROJECTS:VIEW"|instancePermissions) %}hidden{% endif %}>
        <div class="card">
            <div class="card-header rp-toolbar">
                <h3 class="card-title mr-auto">{{ roomGlobal ? 'Alle Raumreservierungen' : 'Raumplanung' }}{% if not roomGlobal %} <small class="text-muted">{{ project.projects_name }}</small>{% endif %}</h3>
                {% if not roomGlobal %}
                    <button id="room-add-booking" class="btn btn-primary btn-sm" disabled>Reservierung hinzufügen</button>
                    <button id="room-generate-request" class="btn btn-default btn-sm" disabled>Raumanfrage erstellen</button>
                    <a id="room-export" href="{{ CONFIG.ROOTURL }}/rooms/export.php?id={{ project.projects_id }}&type=plan" class="btn btn-default btn-sm" target="_blank" rel="noopener">PDF exportieren</a>
                    {% if "ROOMS:VIEW"|instancePermissions %}<a href="{{ CONFIG.ROOTURL }}/rooms/" class="btn btn-default btn-sm">Räume verwalten</a>{% endif %}
                {% endif %}
                <button class="btn btn-default btn-sm" id="room-refresh">Aktualisieren</button>
            </div>
            <div class="card-body">
                <p class="text-muted mb-2">„Bestätigt“ ist ein interner Planungsstatus. Die Buchung im offiziellen Schulsystem erfolgt separat.</p>
                <p id="room-empty-rooms" class="text-muted" hidden>Es gibt noch keine aktiven Räume. Lege zuerst einen Raum im Raumverzeichnis an. Die nötige Berechtigung erteilt die Unternehmensverwaltung.</p>
                <p id="room-readonly" class="text-muted mb-0" hidden>Du kannst die Raumplanung ansehen. Für Buchungen brauchst du Bearbeitungsrechte. Archivierte Projekte sind schreibgeschützt.</p>
            </div>
        </div>
        <div class="row">
            <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted">Geplante Räume</div><strong class="h3" id="room-count">0</strong></div></div></div>
            <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted">Bestätigte Buchungen</div><strong class="h3" id="room-confirmed">0</strong></div></div></div>
            <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted">Offene Anfragen</div><strong class="h3" id="room-open">0</strong><small id="room-requested" class="d-block text-muted"></small></div></div></div>
            <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted">Überschneidungen</div><strong class="h3" id="room-conflicts">0</strong></div></div></div>
        </div>
        <div class="card">
            <div class="card-header rp-toolbar">
                <div class="btn-group" role="group" aria-label="Ansicht der Raumplanung"><button id="room-list-view" class="btn btn-primary" aria-pressed="true">Listenansicht</button><button id="room-timeline-view" class="btn btn-default" aria-pressed="false">Zeitachse</button></div>
                <label class="sr-only" for="room-filter">Nach Raum filtern</label><select id="room-filter" class="form-control w-auto"><option value="">Alle Räume</option></select>
                <label class="sr-only" for="room-status-filter">Nach Status filtern</label><select id="room-status-filter" class="form-control w-auto"><option value="">Alle Status</option></select>
                <div class="d-flex align-items-center"><label for="room-filter-from" class="mb-0 mr-2">Von</label><input type="date" id="room-filter-from" class="form-control w-auto"></div>
                <div class="d-flex align-items-center"><label for="room-filter-to" class="mb-0 mr-2">Bis</label><input type="date" id="room-filter-to" class="form-control w-auto"></div>
                <button id="room-clear-filters" class="btn btn-link btn-sm">Filter zurücksetzen</button>
            </div>
            <div class="card-body pb-2"><small id="room-zone" class="text-muted"></small><small id="room-shown" class="text-muted ml-3"></small></div>
            <div id="room-list-panel" class="table-responsive">
                <table class="table table-hover mb-0" id="room-bookings-table"><thead><tr><th>Raum</th><th>Zeitraum</th><th>Verwendung / Notizen</th><th>Status</th><th>Überschneidungen</th>{% if roomGlobal %}<th>Projekt</th>{% endif %}<th>Aktionen</th></tr></thead><tbody></tbody></table>
            </div>
            <div id="room-timeline-panel" class="card-body" hidden>
                <div class="rp-toolbar mb-3">
                    <button id="room-period-previous" class="btn btn-default btn-sm" aria-label="Vorheriger Zeitraum">‹</button>
                    <button id="room-period-today" class="btn btn-default btn-sm">Heute</button>
                    <button id="room-period-next" class="btn btn-default btn-sm" aria-label="Nächster Zeitraum">›</button>
                    <label class="sr-only" for="room-timeline-date">Datum der Zeitachse</label><input type="date" class="form-control w-auto" id="room-timeline-date">
                    <label class="sr-only" for="room-timeline-scale">Maßstab der Zeitachse</label><select class="form-control w-auto" id="room-timeline-scale"><option value="day">Tag</option><option value="week" selected>Woche</option><option value="month">Monat</option></select>
                    <strong id="room-timeline-range"></strong>
                </div>
                <div id="room-timeline" class="rp-timeline" aria-label="Zeitachse der Raumbelegungen"></div>
                <div id="room-legend" class="rp-toolbar mt-3"></div>
            </div>
        </div>
    </div>
    {% if roomGlobal and not ("PROJECTS:VIEW"|instancePermissions) %}<p class="text-muted">Für die unternehmensweite Belegungsübersicht brauchst du Zugriff auf Projekte.</p>{% endif %}
</div>

<div class="modal fade" id="room-booking-modal" tabindex="-1" role="dialog" aria-labelledby="room-booking-title">
<div class="modal-dialog modal-lg"><form class="modal-content" id="room-booking-form">
    <div class="modal-header"><h4 class="modal-title" id="room-booking-title">Reservierung hinzufügen</h4><button class="close" type="button" data-dismiss="modal" aria-label="Schließen">×</button></div>
    <div class="modal-body">
        <div id="room-booking-error" class="alert alert-danger" role="alert" hidden></div>
        <div class="form-group"><label for="booking-room">Raum</label><select id="booking-room" class="form-control" required></select><small id="booking-room-details" class="text-muted"></small></div>
        <div class="form-row">
            <div class="form-group col-sm-6"><label for="booking-start">Beginn (Datum und Uhrzeit)</label><input id="booking-start" type="datetime-local" class="form-control" min="2000-01-01T00:00" max="2200-12-31T23:59" required></div>
            <div class="form-group col-sm-6"><label for="booking-end">Ende (Datum und Uhrzeit)</label><input id="booking-end" type="datetime-local" class="form-control" min="2000-01-01T00:00" max="2200-12-31T23:59" required></div>
        </div>
        <div class="form-group"><label for="booking-purpose">Verwendung</label><input id="booking-purpose" class="form-control" maxlength="1000" required></div>
        <div class="form-group"><label for="booking-status">Buchungsstatus</label><select id="booking-status" class="form-control"></select></div>
        <div class="form-group"><label for="booking-notes">Notizen (optional)</label><textarea id="booking-notes" class="form-control" rows="3" maxlength="8000"></textarea></div>
        <small id="booking-zone" class="text-muted"></small>
        <div id="room-preview" class="mt-3" role="status" aria-live="polite"></div>
    </div>
    <div class="modal-footer"><a id="booking-project-link" class="btn btn-default" hidden>Projekt öffnen</a><button type="button" class="btn btn-default" data-dismiss="modal">Schließen</button><button type="submit" class="btn btn-primary" id="booking-save">Buchung speichern</button></div>
</form></div></div>

{% if roomGlobal and "ROOMS:MANAGE"|instancePermissions %}
<div class="modal fade" id="room-master-modal" tabindex="-1" role="dialog" aria-labelledby="room-master-title">
<div class="modal-dialog modal-lg"><form class="modal-content" id="room-master-form">
    <div class="modal-header"><h4 id="room-master-title" class="modal-title">Raum hinzufügen</h4><button class="close" type="button" data-dismiss="modal" aria-label="Schließen">×</button></div>
    <div class="modal-body">
        <div id="room-master-error" class="alert alert-danger" role="alert" hidden></div>
        <div class="form-row">
            <div class="form-group col-sm-8"><label for="master-name">Raumname</label><input class="form-control" id="master-name" maxlength="255" required></div>
            <div class="form-group col-sm-4"><label for="master-number">Raumnummer (optional)</label><input class="form-control" id="master-number" maxlength="64"></div>
        </div>
        <div class="form-row">
            <div class="form-group col-sm-6"><label for="master-building">Gebäude / Gelände</label><input class="form-control" id="master-building" maxlength="255"></div>
            <div class="form-group col-sm-6"><label for="master-location">Vorhandener Standort (optional)</label><select class="form-control" id="master-location"><option value="">Kein Standort verknüpft</option></select></div>
        </div>
        <div class="form-row">
            <div class="form-group col-sm-6"><label for="master-capacity">Maximale Kapazität (optional)</label><input type="number" class="form-control" id="master-capacity" min="1" max="1000000"></div>
            <div class="form-group col-sm-6"><label for="master-active">Verfügbarkeit</label><select class="form-control" id="master-active"><option value="1">Aktiv</option><option value="0">Inaktiv</option></select></div>
        </div>
        <div class="form-group"><label for="master-description">Beschreibung (optional)</label><textarea class="form-control" id="master-description" rows="2" maxlength="4000"></textarea></div>
        <div class="form-group"><label for="master-equipment">Ausstattung (optional)</label><textarea class="form-control" id="master-equipment" rows="2" maxlength="4000"></textarea></div>
        <div class="form-group"><label for="master-notes">Allgemeine Notizen (optional)</label><textarea class="form-control" id="master-notes" rows="2" maxlength="8000"></textarea></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-default" data-dismiss="modal">Abbrechen</button><button type="submit" class="btn btn-primary" id="master-save">Raum speichern</button><button type="submit" class="btn btn-danger" id="master-delete">Raum löschen</button></div>
</form></div></div>
{% endif %}

<div class="modal fade" id="room-request-modal" tabindex="-1" role="dialog" aria-labelledby="room-request-title">
<div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header"><h4 id="room-request-title" class="modal-title">Raumanfrage erstellen</h4><button class="close" type="button" data-dismiss="modal" aria-label="Schließen">×</button></div>
    <div class="modal-body">
        <p class="text-muted">Enthält geplante und angefragte Buchungen. Der Entwurf ändert den Buchungsstatus beim Erstellen oder Kopieren nicht.</p>
        <label for="room-request-subject">E-Mail-Betreff</label><input id="room-request-subject" class="form-control mb-3" readonly>
        <label for="room-request-body">E-Mail-Entwurf</label><textarea id="room-request-body" rows="16" class="form-control" readonly></textarea>
        <div id="room-copy-status" class="text-muted mt-2" role="status"></div>
    </div>
    <div class="modal-footer"><button id="room-copy-request" class="btn btn-primary">E-Mail-Text kopieren</button><a id="room-open-mail" class="btn btn-default">E-Mail-App öffnen</a><a id="room-request-pdf" class="btn btn-default" target="_blank" rel="noopener">Anfrage als PDF herunterladen</a><button class="btn btn-default" data-dismiss="modal">Schließen</button></div>
</div></div></div>
<script src="{{ CONFIG.ROOTURL }}/rooms/planning.js"></script>
