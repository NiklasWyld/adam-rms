<!doctype html>
<html lang="de"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ exportType == 'request' ? 'Raumanfrage' : 'Raumplanung' }} - {{ roomPlan.project.projects_name }}</title>
{% include 'assets/templates/pdf/scripts.twig' %}
<style>body{font:16px/1.6 system-ui,sans-serif;color:#263238;background:#f4f6f9;padding:24px}main{max-width:700px;margin:24px auto;background:white;border:1px solid #dee2e6;border-radius:6px;padding:32px}h1{font-size:24px;overflow-wrap:anywhere}button{font:inherit;padding:8px 16px;cursor:pointer;margin:4px 4px 4px 0}#room-pdf-error{color:#a32323}</style>
</head><body><main>
<h1>{{ exportType == 'request' ? 'Raumanfrage' : 'Raumplanung' }}</h1>
<p>{{ roomPlan.project.projects_name }}</p>
<p>{{ exportType == 'request' ? 'Enthält geplante und angefragte Belegungen. Der Reservierungsstatus bleibt beim Export erhalten.' : 'Alle gespeicherten Raumbelegungen mit Status und Überschneidungen.' }}</p>
<p id="room-pdf-status" role="status">PDF wird erstellt …</p>
<p id="room-pdf-error" role="alert"></p>
<button id="room-pdf-download" disabled>PDF herunterladen</button>
<button id="room-pdf-open" disabled>PDF öffnen</button>
<p><a href="{{ CONFIG.ROOTURL }}/project/?id={{ roomPlan.project.projects_id }}#room-planning-view">Zur Raumplanung</a></p>
</main>
{% include 'assets/templates/pdf/business.twig' %}
<script type="application/json" id="room-pdf-data">{{ {plan: roomPlan, type: exportType, date: "now"|date('d.m.Y, H:i', roomPlan.timeZone)}|json_encode(15)|raw }}</script>
<script src="{{ CONFIG.ROOTURL }}/rooms/pdf.js"></script>
</body></html>
