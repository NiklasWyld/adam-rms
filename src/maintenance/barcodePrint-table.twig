<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <title>Barcodeliste - {{ USERDATA.instance.instances_name }}</title>
    <link rel="stylesheet" href="{{ CONFIG.ROOTURL }}/static-assets/css/pdfPrint.css">
</head>
<body class="pdf-print-report">
    <header class="pdf-print-header">
        {% if CONFIG.FILES_ENABLED == 'Enabled' and USERDATA.instance.instances_storageEnabled == 1 and USERDATA.instance.instances_logo %}
            <img src="{{ USERDATA.instance.instances_logo|s3URL('medium') }}" alt="Firmenlogo">
        {% endif %}
        <p>{{ USERDATA.instance.instances_name }}</p>
        <h1>Barcodeliste</h1>
    </header>
    <main class="pdf-print-content">
        <table>
            <thead><tr><th>Material-ID</th><th>Materialtyp</th><th>Barcode</th><th>Barcodetyp</th></tr></thead>
            <tbody>
                {% for asset in assets %}
                    <tr>
                        <td>{{ asset.isAsset ? asset.assets_tag : 'Noch keinem Material zugeordnet' }}</td>
                        <td>{{ asset.isAsset ? asset.assetTypes_name : 'Noch keinem Material zugeordnet' }}</td>
                        <td>{{ asset.barcode.assetsBarcodes_value }}</td>
                        <td>{{ asset.barcode.assetsBarcodes_type }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </main>
</body>
</html>
