<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>Materialetiketten - {{ USERDATA.instance.instances_name }}</title>
<link rel="stylesheet" href="{{ CONFIG.ROOTURL }}/static-assets/css/pdfPrint.css">
<style>
    @page { size: A4; margin: 0; }
    body {
        font-size: {{ GET.numStickers == "8cable" ? '9' : '18' }}px;
        font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif;
        padding: 0;
        margin: 0;
        /* Print spooler needs to know to print background colours */
        -webkit-print-color-adjust:exact !important;
        print-color-adjust:exact !important;
    }
    
    .container {
        width: 100%;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        flex-flow: row wrap;
    }

    .item {
        padding: 10px;
        flex: 0 1 auto;
        margin: 5px
    }

    .border {
        break-inside: avoid;
        border: 1px solid #000;
    }
</style>

</head>
<body>
    <div class="container">
        {% for asset in assets %}
            <div class="item border">
                {% include 'maintenance/individualBarcode.twig' with {asset: asset,GET:GET} %}
            </div>
        {% endfor %}
    </div>
</body>
</html>
