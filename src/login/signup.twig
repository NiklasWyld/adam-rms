{% extends "login/login_template.twig" %}
{% block content %}
   <div class="spinner-border" role="status" id="loadingOverlay" style="display: none;">
        <span class="sr-only">Wird geladen …</span>
    </div>
    <form id="signupForm">
        <div id="errorMessageBox" class="alert alert-danger"></div>
        <input class="form-control form-control-lg" id="signupForm_users_email" maxlength="100" required placeholder="E-Mail-Adresse eingeben" autocomplete="email" type="email" style="margin-top: 10px; margin-bottom: 10px;">
        <input class="form-control form-control-lg" id="signupForm_users_username" minlength="6" maxlength="100" required placeholder="Benutzernamen wählen" autocomplete="username"  type="text" style="margin-top: 10px; margin-bottom: 10px;">
        <input class="form-control form-control-lg" id="signupForm_users_password" minlength="12" maxlength="100" required placeholder="Passwort wählen (mindestens 12 Zeichen)" autocomplete="new-password"  type="password" style="margin-top: 10px; margin-bottom: 5px;">
        <p class="text-muted small" style="margin-top: 0; margin-bottom: 10px;">Wähle ein starkes, einzigartiges Passwort. Wir empfehlen einen Passwortmanager wie <a href="https://bitwarden.com" target="_blank" rel="noopener noreferrer">Bitwarden</a> , um sichere Passwörter zu erstellen und zu speichern.</p>
        <input class="form-control form-control-lg" id="signupForm_users_name1" minlength="1" maxlength="100" required autocomplete="given-name" placeholder="Vorname" type="text" style="margin-top: 10px; margin-bottom: 10px;">
        <input class="form-control form-control-lg" id="signupForm_users_name2" minlength="1" maxlength="100" required autocomplete="family-name" placeholder="Nachname" type="text" style="margin-top: 10px; margin-bottom: 10px;">
        <button class="btn btn-secondary" type="submit" value="Submit">Registrieren</button>
    </form>
	<script>
		$( document ).ready(function() {
            $("#signupForm").submit(function(e){
                e.preventDefault();
                $("#signupForm").hide();
                $("#loadingOverlay").show();
                $.ajax({
                    url: "../api/login/signup.php",
                    type: "POST",
                    dataType: 'json',
                    data: {
                        "name1": $("#signupForm_users_name1").val(),
                        "name2": $("#signupForm_users_name2").val(),
                        "password": $("#signupForm_users_password").val(),
                        "username": $("#signupForm_users_username").val(),
                        "email": $("#signupForm_users_email").val()
                    }, success: function (result) {
                        if (result.result) {
                            $.ajax({
                                url: "../api/login/login.php",
                                type: "POST",
                                dataType: 'json',
                                data: {"formInput" : $("#signupForm_users_username").val(),"password": $("#signupForm_users_password").val()},
                                success: function(result) {
                                    if (result.result) {
                                        window.location.href = result.response.redirect;
                                    } else {
                                        $("#signupForm").show();
                                        $("#loadingOverlay").hide();
                                        $("#errorMessageBox").html(adamUiError(result.error.message));
                                        $("#errorMessageBox").show();
                                    }
                                },
                                error: function(){
                                    $("#signupForm").show();
                                    $("#loadingOverlay").hide();
                                    $("#errorMessageBox").html("Das Konto wurde erstellt. Die Anmeldung ist fehlgeschlagen. Prüfe deine Internetverbindung und lade die Seite neu.");
                                    $("#errorMessageBox").show();
                                }
                            });
                        } else {
                            $("#signupForm").show();
                            $("#loadingOverlay").hide();
                            $("#errorMessageBox").html(adamUiError(result.error.message));
                            $("#errorMessageBox").show();
                        }
                    }, error: function () {
                        $("#signupForm").show();
                        $("#loadingOverlay").hide();
                        $("#errorMessageBox").html("Prüfe deine Internetverbindung und lade die Seite neu.");
                        $("#errorMessageBox").show();
                    }
                });
            });
            
            function formVerifyEmail() {
                //They want us to send out another verification email
                if (initialData.hasOwnProperty("error") && initialData.error.hasOwnProperty("userid")) {
                    var userid = initialData.error.userid;
                } else {
                    var userid = initialData.response.data.userid;
                }
                $.ajax({
                    url: "../api/login/reSendVerificationEmail.php",
                    type: "POST",
                    dataType: 'json',
                    data: {
                        "userid": userid
                    }, success: function (result) {
                        if (result.result) {
                            toastr.success("E-Mail erneut gesendet");
                        } else {
                            toastr.error("Die E-Mail-Adresse konnte nicht bestätigt werden. Wende dich an den Support.");
                        }
                    }, error: function () {
                        toastr.error("Prüfe deine Internetverbindung und lade die Seite neu.");
                    }
                });
            }
        });
	</script>
{% endblock %}
