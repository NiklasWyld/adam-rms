{% extends "login/login_template.twig" %}
{% block content %}
    {% if googleAuthAvailable %}
    <a href="{{CONFIG.ROOTURL}}/login/oauth/google.php" class="btn btn-default btn-lg m-2 border shadow-sm"><img src="{{ CONFIG.ROOTURL}}/static-assets/img/login/google.svg" alt="" role="presentation" style="height: 1.2em; vertical-align: text-top;" /> Anmelden{% if signupEnabled %} oder registrieren{% endif %} mit Google</a><br/>
    {% endif %}
    {% if microsoftAuthAvailable %}
    <a href="{{CONFIG.ROOTURL}}/login/oauth/microsoft.php" class="btn btn-default btn-lg m-2 border shadow-sm"><img src="{{ CONFIG.ROOTURL}}/static-assets/img/login/microsoft.svg" alt="" role="presentation" style="height: 1.2em; vertical-align: text-top;" /> Anmelden{% if signupEnabled %} oder registrieren{% endif %} mit Microsoft</a><br/>
    {% endif %}
    {% if signupEnabled %}
    <a href="?signup" class="btn btn-default btn-lg m-2 border shadow-sm">
        {% if CONFIG.FILES_ENABLED == "Enabled" and CONFIG.PROJECT_LOGO == "Custom" %}
        <img src="{{ CONFIG.PROJECT_LOGO_CUSTOM|s3URL("small") }}" alt="{{ CONFIG.PROJECT_NAME }} Logo" role="presentation" style="height: 1.2em; vertical-align: text-top;"/>			
        {% else %}
        <img src="{{ CONFIG.ROOTURL}}/static-assets/img/logoicon.png" alt="AdamRMS Logo" role="presentation" style="height: 1.2em; vertical-align: text-top;" />
        {% endif %}
        Neues {{ CONFIG.PROJECT_NAME }} Konto erstellen
    </a>
    <p>oder</p>
    {% endif %}
    <div class="spinner-border" role="status" id="loadingOverlay" style="display: none;">
        <span class="sr-only">Wird geladen …</span>
    </div>
    <form id="loginForm">
        <div id="errorMessageBox" class="alert alert-danger"></div>
		<input class="form-control form-control-lg" id="emailInput" autocomplete="username" placeholder="Mit Benutzername oder E-Mail anmelden" type="text" required style="margin-top: 10px; margin-bottom: 10px;" autofocus>
        <input class="form-control form-control-lg" id="passwordInput" placeholder="Passwort" autocomplete="current-password" type="password" required style="margin-top: 10px; margin-bottom: 10px;">
		<div style="width: 100%; text-align:right;">
            <button type="button" class="btn btn-default" id="passwordResetButton">Passwort zurücksetzen</button>
            <button class="btn btn-secondary" type="submit" value="Submit">Anmelden</button>
		</div>
	</form>
	<script>
        $("#loginForm").submit(function(e){
            e.preventDefault();
            $("#loginForm").hide();
            $("#loadingOverlay").show();
            $.ajax({
                url: "../api/login/login.php",
                type: "POST",
                dataType: 'json',
                data: {"formInput" : $("#emailInput").val(),"password": $("#passwordInput").val()},
                success: function(result) {
                    if (result.result) {
                        window.location.href = result.response.redirect;
                    } else {
                        $("#loginForm").show();
                        $("#loadingOverlay").hide();
                        $("#errorMessageBox").html(adamUiError(result.error.message));
                        $("#errorMessageBox").show();
                    }
                },
                error: function(){
                    $("#loginForm").show();
                    $("#loadingOverlay").hide();
                    $("#errorMessageBox").html("Prüfe deine Internetverbindung und lade die Seite neu.");
                    $("#errorMessageBox").show();
                }
            });
        });
        $('#passwordResetButton').click(function(){
            if ($("#emailInput").val().length <= 0) {
                $("#errorMessageBox").html("Gib deinen Benutzernamen oder deine E-Mail-Adresse ein, um dein Passwort zurückzusetzen.");
                $("#errorMessageBox").show();
                return;
            }
            $("#errorMessageBox").hide();
            $("#loginForm").hide();
            $("#loadingOverlay").show();
            $.ajax({
                url: "../api/login/forgotPassword.php",
                type: "POST",
                dataType: 'json',
                data: {"formInput" : $("#emailInput").val()},
                success: function(result) {
                    $("#loginForm").show();
                    $("#loadingOverlay").hide();
                    if (result.result) {
                        $("#errorMessageBox").html("Wenn zu dieser Adresse ein Konto besteht, erhältst du per E-Mail einen Link zum Zurücksetzen des Passworts. Folge den Anweisungen in der E-Mail.");
                        $("#errorMessageBox").show();
                    } else {
                        $("#errorMessageBox").html("Wende dich für ein neues Passwort an den Support.");
                        $("#errorMessageBox").show();
                    }
                }, error: function(){
                    $("#loginForm").show();
                    $("#loadingOverlay").hide();
                    $("#errorMessageBox").html("Prüfe deine Internetverbindung und lade die Seite neu.");
                    $("#errorMessageBox").show();
                }
            });

        });
	</script>
{% endblock %}
