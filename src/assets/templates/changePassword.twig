<div class="row">
  <div class="col-lg-6 offset-lg-3 col-md-12" style="padding: 5px;">
      <div class="card card-default">
          <div class="card-body" style="text-align: center;">
              <h2>Du musst dein Passwort ändern</h2>
                  <p>Gib ein neues Passwort ein:</p>
                  <input type="password" id="forcechangepass1" class="form-control input-lg"
                          placeholder="Neues Passwort (mindestens 12 Zeichen)" style="margin-bottom: 5px;" />
                  <input type="password" id="forcechangepass2" class="form-control input-lg"
                          placeholder="Neues Passwort bestätigen"  style="margin-bottom: 5px;" />
                  <p>Wähle ein starkes Passwort mit mindestens 12 Zeichen. Wir empfehlen einen Passwortmanager wie <a href="https://bitwarden.com" target="_blank" rel="noopener noreferrer">Bitwarden</a> , um sichere Passwörter zu erstellen und zu speichern.</p>
                  <button id="forcechangepassbutton" class="btn btn-default">Speichern</button>

          </div>
          <div class="card-footer">
<a href="{{ CONFIG.LINKS_SUPPORTURL }}">Support kontaktieren</a>

          </div>
          <script>
              $(document).ready(function () {
                  $('#forcechangepassbutton').click(function () {
                      if ($("#forcechangepass1").val() != $("#forcechangepass2").val()) bootbox.alert("Die Passwörter stimmen nicht überein.");
                      else if ($("#forcechangepass1").val().length < 12) bootbox.alert("Das Passwort muss mindestens 12 Zeichen lang sein.");
                      else {
                          $.ajax({
                              url: '{{ CONFIG.ROOTURL }}/api/account/forcePasswordChange.php',
                              type: 'POST',
                              contentType: 'application/json',
                              data: JSON.stringify({ pass: $("#forcechangepass1").val() }),
                              success: function (result) {
                                  if (result == '1') {
                                      location.reload();
                                  } else {
                                      bootbox.alert('Die E-Mail konnte nicht erneut gesendet werden. Lade die Seite neu und versuche es erneut.');
                                  }
                              }
                          });
                      }
                  });
              });
          </script>
      </div>
  </div>
</div>