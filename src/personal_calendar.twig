{% extends "assets/template.twig" %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Mein Kalender</h3>
            </div>
            <div class="card-body">

                {% if googleCalendarEmbedUrl %}
                    <div style="width:100%; height:80vh;">
                        <iframe
                            src="{{ googleCalendarEmbedUrl }}"
                            style="border:0"
                            width="100%"
                            height="100%"
                            title="Mein Kalender"
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"
                            frameborder="0"
                            scrolling="no">
                        </iframe>
                    </div>
                {% else %}
                    <div class="alert alert-warning">
                        Es ist kein Kalender eingerichtet.<br>
                        Hinterlege die Einbettungs-URL von Google Kalender in den
                        <a href="{{ CONFIG.ROOTURL }}/instances/calendarSettings.php">
                            Kalendereinstellungen
                        </a>.
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
</div>
{% endblock %}