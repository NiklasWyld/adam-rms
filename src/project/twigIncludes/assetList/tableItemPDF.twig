{% if type.assets|length > 1 %}
    [
        {% if GET.checkboxes %}'[  ]',{% endif %}
        {% if GET.type == 'deliveryNote' %}{ text: '{{ type.assets|length }}', alignment: 'right', bold: true },{% endif %}
        { text: pdf.wrap("{{ ((GET.type == 'deliveryNote' ? '' : type.assets|length ~ ' × ') ~ (type.assets[0].manufacturers_id != 1 ? type.assets[0].manufacturers_name ~ ' - ' : '') ~ type.assets[0].assetTypes_name)|escape('js') }}"),
            bold: true, colSpan: {{ GET.comments ? 3 : 2 }} },
        {}, {% if GET.comments %}{},{% endif %}
        {% if GET.masses %}{ text: "{{ type.totals.mass > 0 ? type.totals.mass|pdfMass|escape('js') : '' }}", alignment: 'right' },{% endif %}
        {% if finance and GET.prices %}{ text: "{{ type.totals.price|pdfMoney|escape('js') }}", alignment: 'right' },{% endif %}
        {% if finance and GET.discounts %}{ text: "{{ type.totals.discountPrice|pdfMoney|escape('js') }}", alignment: 'right' },{% endif %}
    ],
{% endif %}
{% for asset in type.assets %}
    {% if type.assets|length == 1 or GET.showAll %}
    [
        {% if GET.checkboxes %}'[  ]',{% endif %}
        {% if GET.type == 'deliveryNote' %}{ text: '{{ type.assets|length == 1 ? 1 : '' }}', alignment: 'right' },{% endif %}
        { text: pdf.wrap("{% if type.assets|length == 1 %}{{ (asset.manufacturers_id != 1 ? asset.manufacturers_name ~ ' - ' : '')|escape('js') }}{{ asset.assetTypes_name|escape('js') }}{% endif %}{% if GET.showAll %}{% if type.assets|length == 1 %} · {% endif %}{{ asset.assets_tag|aTag|escape('js') }}{% endif %}{% if GET.flagsBlocks %}{% for flag in asset.flagsblocks.FLAG %} [F]{% endfor %}{% for flag in asset.flagsblocks.BLOCK %} [B]{% endfor %}{% endif %}{% if asset.assetsAssignments_linkedTo %} [L]{% endif %}") },
        {% if GET.comments %}pdf.wrap("{{ asset.assetsAssignments_comment|escape('js') }}"),{% endif %}
        { stack: [
            {% if asset.assetsAssignmentsStatus_name %}
                { text: pdf.wrap("{{ asset.assetsAssignmentsStatus_name|escape('js') }}"), style: 'muted' },
            {% endif %}
            {% for field in asset.assetTypes_definableFields|split(',') %}
                {% if field != '' %}pdf.wrap("{{ (field ~ ': ' ~ attribute(asset, 'asset_definableFields_' ~ loop.index))|escape('js') }}"),{% endif %}
            {% endfor %}
        ] },
        {% if GET.masses %}
            {% set mass = asset.assets_mass is not null ? asset.assets_mass : asset.assetTypes_mass %}
            { text: "{{ mass ? mass|pdfMass|escape('js') : '' }}", alignment: 'right' },
        {% endif %}
        {% if finance and GET.prices %}{ text: "{{ asset.price|pdfMoney|escape('js') }}", alignment: 'right' },{% endif %}
        {% if finance and GET.discounts %}{ text: "{{ asset.discountPrice|pdfMoney|escape('js') }}", alignment: 'right' },{% endif %}
    ],
    {% endif %}
{% endfor %}
