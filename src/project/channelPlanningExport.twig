<!doctype html>
<html lang="de"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Kanalplan - {{ project.projects_name }}</title>
{% include 'assets/templates/pdf/scripts.twig' %}
<style>body{font:16px/1.6 system-ui,sans-serif;color:#263238;background:#f4f6f9;padding:32px}main{max-width:700px;margin:32px auto;background:white;border:1px solid #dee2e6;border-radius:6px;padding:32px}h1{font-size:24px;overflow-wrap:anywhere}button{font:inherit;padding:8px 16px;cursor:pointer}label{display:block}select{font:inherit;max-width:100%;padding:6px;margin:8px 0}#channel-pdf-error{color:#a32323}</style>
</head><body><main>
<h1>Kanalplan</h1><p>{{ project.projects_name }}</p>
<label for="channel-pdf-layout">PDF-Layout</label>
<select id="channel-pdf-layout"><option value="detail">Detailansicht (bei Bedarf mehrseitig)</option><option value="single">Einblattansicht (A4 Hochformat)</option></select>
<p style="font-size:14px;color:#586574">Die Einblattansicht verkleinert den Inhalt. Für größere Schrift wähle die Detailansicht.</p>
<p id="channel-pdf-status" role="status">PDF wird erstellt …</p>
<p id="channel-pdf-error" role="alert"></p>
<button id="channel-pdf-download" disabled>PDF herunterladen</button>
<button id="channel-pdf-open" disabled>PDF öffnen</button>
<p><a href="{{ CONFIG.ROOTURL }}/project/?id={{ project.projects_id }}#channel-planning-view">Zum Kanalplan</a></p>
</main>
{% include 'assets/templates/pdf/business.twig' %}
<script type="application/json" id="channel-pdf-data">{{ {plan: channelPlan, project: project.projects_name, projectId: project.projects_id, date: "now"|date('d.m.Y, H:i', 'Europe/Berlin')}|json_encode(15)|raw }}</script>
<script src="{{ CONFIG.ROOTURL }}/project/channelPlanningPdf.js"></script>
</body></html>
