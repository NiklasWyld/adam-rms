{% macro materials(title, groups, options, financesEnabled) %}
    {% set widths = [] %}
    {% set withAmounts = financesEnabled and (options.prices or options.discounts) %}
    {% set headers = [] %}
    {% if options.checkboxes %}
        {% set widths = widths|merge([15]) %}
        {% set headers = headers|merge(['']) %}
    {% endif %}
    {% if options.type == 'deliveryNote' %}
        {% set widths = widths|merge([34]) %}
        {% set headers = headers|merge(['Menge']) %}
    {% endif %}
    {% set widths = widths|merge(['*']) %}
    {% set headers = headers|merge(['Material']) %}
    {% if options.comments %}
        {% set widths = widths|merge([withAmounts ? 66 : 78]) %}
        {% set headers = headers|merge(['Bemerkungen']) %}
    {% endif %}
    {% set widths = widths|merge([withAmounts ? 59 : 100]) %}
    {% set headers = headers|merge(['Details']) %}
    {% if options.masses %}
        {% set widths = widths|merge([withAmounts ? 40 : 50]) %}
        {% set headers = headers|merge(['Gewicht']) %}
    {% endif %}
    {% if financesEnabled and options.prices %}
        {% set widths = widths|merge([54]) %}
        {% set headers = headers|merge(['Preis']) %}
    {% endif %}
    {% if financesEnabled and options.discounts %}
        {% set widths = widths|merge([64]) %}
        {% set headers = headers|merge(['Nach Rabatt']) %}
    {% endif %}
    letter.materialTable("{{ title|escape('js') }}", {{ headers|json_encode(15)|raw }}, {{ widths|json_encode(15)|raw }}, [
        {% set category = null %}
        {% for group in groups %}
            {% set nextCategory = group.assets[0].assetCategories_name|default('Ohne Kategorie') %}
            {% if nextCategory != category %}
                {% set category = nextCategory %}
                [{ text: pdf.wrap("{{ category|escape('js') }}"), colSpan: {{ widths|length }}, bold: true, fillColor: '#e7eef3' }
                    {% for i in 2..widths|length %}, {}{% endfor %}],
            {% endif %}
            {% include 'project/twigIncludes/assetList/tableItemPDF.twig' with { type: group, GET: options, finance: financesEnabled } only %}
        {% endfor %}
    ]),
{% endmacro %}
{% import _self as layout %}
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="referrer" content="no-referrer">
    <title>{{ GET.fileType }} - {{ project.projects_name }}</title>
    {% include 'assets/templates/pdf/scripts.twig' %}
    <script src="{{ CONFIG.ROOTURL }}/project/businessLetterPdf.js"></script>
</head>
<body>
<main>
    <h1>{{ GET.fileType }} - {{ project.projects_name }}</h1>
    {% if pdfCleanCopy %}
        <p>Die PDF-Datei wird ohne Entwurfskennzeichnung heruntergeladen. Sie wird nicht im Projekt abgelegt.</p>
    {% endif %}
    {% if invoicePdf.errors|default([]) %}
        <p>{% if pdfDraft %}Das PDF wird als Entwurf erstellt. {% endif %}Vor der Ausstellung fehlen folgende Voraussetzungen.</p>
        <ul id="invoice-pdf-checks">{% for reason in invoicePdf.errors %}<li>{{ reason }}</li>{% endfor %}</ul>
    {% endif %}
    <p id="project-pdf-status" role="status">PDF wird erstellt …</p>
    <p id="project-pdf-error" role="alert"></p>
    {% if GET.type == 'invoice' and pdfSave %}
        <button id="project-pdf-issue">Rechnung speichern und herunterladen</button>
    {% endif %}
    <button id="project-pdf-download" disabled>PDF herunterladen</button>
    <button id="project-pdf-open" disabled>PDF öffnen</button>
</main>
{% include 'assets/templates/pdf/business.twig' %}
<script type="application/json" id="project-pdf-data">{{ {
    title: GET.fileType, project: project.projects_name, projectId: project.projects_id,
    type: GET.type, version: fileNumber, save: pdfSave, draft: pdfDraft, invoice: invoicePdf|default(null),
    cleanCopy: pdfCleanCopy, token: invoiceToken|default(null), upload: CONFIG.ROOTURL ~ '/api/s3files/uploadProjectInvoice.php',
    recipient: project.projectsTypes_config_client == 1 ? {
        name: project.clients_name, address: GET.addresses or GET.type == 'invoice' ? project.clients_address : '',
        email: GET.addresses ? project.clients_email : '', phone: GET.addresses ? project.clients_phone : '',
        website: GET.addresses ? project.clients_website : ''
    } : {},
    address: GET.addresses or GET.type == 'invoice',
    manager: GET.pmdetails ? (project.users_name1 ~ ' ' ~ project.users_name2)|trim : '',
    managerEmail: GET.pmdetails ? project.users_email : '',
    exported: 'now'|date('d.m.Y', 'Europe/Berlin')
}|json_encode(15)|raw }}</script>
<script>
(() => {
    'use strict';
    const pdf = window.AdamPdf;
    const source = pdf.business();
    const data = pdf.read('project-pdf-data');
    const invoice = data.invoice;
    const letter = window.AdamBusinessLetter;
    const info = [
        [invoice ? 'Rechnungsdatum' : 'Dokumentdatum', invoice ? invoice.issued : data.exported],
        [invoice ? 'Rechnungs-Nr.' : 'Version', invoice ? invoice.number : String(data.version)],
        ['Projekt-Nr.', String(data.projectId)],
        ['Projektleitung', data.manager],
        ['E-Mail', data.managerEmail || source.email],
        ['Telefon', source.phone]
    ].filter(([, value]) => value);
    const projectDetails = [
        {% if project.projectsStatuses_name %}['Projektstatus', "{{ project.projectsStatuses_name|escape('js') }}"],{% endif %}
        {% if project.projects_dates_deliver_start %}['Anlieferung', "{{ project.projects_dates_deliver_start|date('d.m.Y, H:i') }}"],{% endif %}
        {% if project.projects_dates_use_start %}['Veranstaltungsbeginn', "{{ project.projects_dates_use_start|date('d.m.Y, H:i') }}"],{% endif %}
        {% if project.projects_dates_use_end %}['Veranstaltungsende', "{{ project.projects_dates_use_end|date('d.m.Y, H:i') }}"],{% endif %}
        {% if project.projects_dates_deliver_end %}['Abholung', "{{ project.projects_dates_deliver_end|date('d.m.Y, H:i') }}"],{% endif %}
        {% if GET.totalmass and project.projectsTypes_config_assets == 1 %}['Gewicht (ca.)', "{{ FINANCIALS.mass|pdfMass|escape('js') }}"],{% endif %}
        {% if GET.totalvalue and project.projectsTypes_config_assets == 1 %}['Materialwert (ca.)', "{{ FINANCIALS.value|pdfMoney|escape('js') }}"],{% endif %}
        {% if GET.venue and project.projectsTypes_config_venue == 1 and project.locations_name %}
        ['Veranstaltungsort', "{{ (project.locations_name ~ (project.locations_address ? '\n' ~ project.locations_address : ''))|escape('js') }}"],
        {% endif %}
    ];
    const details = [];
    if (invoice) {
        if (invoice.start) details.push([invoice.end && invoice.end !== invoice.start ? 'Leistungszeitraum' : 'Leistungsdatum',
            invoice.end && invoice.end !== invoice.start ? invoice.start + ' bis ' + invoice.end : invoice.start]);
        if (invoice.due) details.push(['Fällig am', invoice.due]);
        if (invoice.taxNumber) details.push(['Steuernummer', invoice.taxNumber]);
        if (invoice.vatId) details.push(['USt-IdNr.', invoice.vatId]);
    }
    details.push(...projectDetails);
    const recipientContact = [data.recipient.email, data.recipient.phone, data.recipient.website].filter(Boolean);
    if (recipientContact.length) details.push(['Empfängerkontakt', recipientContact.join(' · ')]);
    const content = letter.front(source, data, info);
    if (details.length) content.push(letter.details(details));
    if (invoice?.errors.length && !data.cleanCopy) content.push({
        text: ['Entwurf - Pflichtangaben und Voraussetzungen prüfen\n', ...invoice.errors.map(reason => '• ' + reason + '\n')],
        color: '#8b2727', margin: [0, 0, 0, 12]
    });
    if (invoice?.rows.length) {
        const price = text => ({ text, alignment: 'right' });
        content.push(pdf.heading('Rechnungspositionen'));
        const unit = invoice.totals ? 'Einzelpreis netto' : 'Einzelpreis';
        const total = invoice.totals ? 'Betrag netto' : 'Betrag';
        content.push(pdf.table(['Pos.', 'Leistung / Artikel', 'Menge', unit, total], [24, '*', 47, 87, 87],
            invoice.rows.map((row, index) => [
                String(index + 1), { stack: [{ text: pdf.wrap(row.name), bold: true }, { text: row.category, style: 'muted' }] },
                price(pdf.number(row.quantity, { maximumFractionDigits: 3 })), price(row.unit), price(row.total)
            ])));
        if (invoice.totals) {
            const totals = [['Nettoentgelt', invoice.totals.net]];
            if (invoice.rate > 0) totals.push(['Umsatzsteuer ' + invoice.rate + ' %', invoice.totals.vat]);
            totals.push([invoice.rate ? 'Rechnungsbetrag brutto' : 'Rechnungsbetrag', invoice.totals.gross]);
            if (invoice.totals.received) totals.push(['Erfasste Zahlungseingänge (ungeprüft)', invoice.totals.received]);
            content.push({ unbreakable: true, table: { widths: ['*', 100], body: totals.map(([label, amount]) => [
                { text: label, alignment: 'right', bold: true }, price(amount)
            ]) }, layout: 'noBorders' });
        }
        if (invoice.taxNote) content.push({ text: invoice.taxNote, margin: [0, 6, 0, 0] });
    }
    content.push(
        {% if GET.type != 'deliveryNote' and (GET.paymentTerms or GET.type == 'invoice') %}
            {% set terms = (GET.type == 'quote' ? USERDATA.instance.instances_quoteTerms : USERDATA.instance.instances_termsAndPayment)|pdfPlainHtml %}
            {% if terms %}
                letter.section('{{ GET.type == "quote" ? "Angebotsbedingungen" : "Zahlungsbedingungen" }}', "{{ terms|escape('js') }}"),
            {% endif %}
        {% endif %}
    );
    if (invoice?.bankDetails) content.push(letter.section('Bankverbindung', invoice.bankDetails));
    content.push(
        {% if GET.finance %}
            pdf.heading('Projektbeträge'),
            pdf.table(['Position', 'Betrag'], ['*', 105], [
                ['Material vor Rabatt', { text: "{{ FINANCIALS.prices.subTotal|pdfMoney|escape('js') }}", alignment: 'right' }],
                ['Rabatte', { text: "{{ FINANCIALS.prices.discounts|pdfMoney|escape('js') }}", alignment: 'right' }],
                ['Material nach Rabatt', { text: "{{ FINANCIALS.prices.total|pdfMoney|escape('js') }}", alignment: 'right' }],
                ['Verkäufe', { text: "{{ FINANCIALS.payments.sales.total|pdfMoney|escape('js') }}", alignment: 'right' }],
                ['Personal', { text: "{{ FINANCIALS.payments.staff.total|pdfMoney|escape('js') }}", alignment: 'right' }],
                ['Zumietungen', { text: "{{ FINANCIALS.payments.subHire.total|pdfMoney|escape('js') }}", alignment: 'right' }],
                [{ text: 'Projektentgelt', bold: true }, { text: "{{ FINANCIALS.payments.subTotal|pdfMoney|escape('js') }}", alignment: 'right', bold: true }]
            ]),
        {% endif %}
        {% if project.projects_invoiceNotes and GET.invoiceNotes %}
            letter.section('Abrechnungshinweise', "{{ project.projects_invoiceNotes|escape('js') }}"),
        {% endif %}
        {% if project.projects_deliveryNotes and GET.type == 'deliveryNote' %}
            letter.section('Lieferhinweise', "{{ project.projects_deliveryNotes|escape('js') }}"),
        {% endif %}
        {% if GET.assets and project.projectsTypes_config_assets == 1 %}
            {% set count = 0 %}
            {% for group in FINANCIALS.assetsAssigned %}{% set count = count + group.assets|length %}{% endfor %}
            {% for business in FINANCIALS.assetsAssignedSUB %}{% for group in business.assets %}{% set count = count + group.assets|length %}{% endfor %}{% endfor %}
            {% if FINANCIALS.assetsAssigned %}
                {{ layout.materials('Materialliste', FINANCIALS.assetsAssigned, GET, project.projectsTypes_config_finance == 1) }}
            {% endif %}
            {% for business in FINANCIALS.assetsAssignedSUB %}
                {{ layout.materials('Materialliste - ' ~ business.instance.instances_name, business.assets, GET, project.projectsTypes_config_finance == 1) }}
            {% endfor %}
            {% if count > 0 %}
                {% if GET.flagsBlocks %}{ text: '[F] Markiert  ·  [B] Gesperrt', style: 'muted' },{% endif %}
                { text: '[L] Mit einem anderen Material verknüpft', style: 'muted' },
                { text: 'Geräte insgesamt: ' + pdf.number({{ count }}), bold: true, alignment: 'right' },
            {% else %}
                { text: 'Dem Projekt ist kein Material zugeordnet.', style: 'muted' },
            {% endif %}
        {% endif %}
        {% for key, label in {subHires: 'Zumietungen', sales: 'Verkäufe', staff: 'Personal'} %}
            {% set entries = attribute(FINANCIALS.payments, key == 'subHires' ? 'subHire' : key) %}
            {% if GET[key] and entries.ledger %}
                pdf.heading('{{ label }}'),
                pdf.table(['Menge', 'Position / Lieferant'{% if GET.prices %}, 'Einzelpreis', 'Gesamt'{% endif %}],
                    [46, '*'{% if GET.prices %}, 84, 84{% endif %}], [
                    {% for payment in entries.ledger %}
                        [
                            { text: pdf.number({{ payment.payments_quantity|json_encode(15)|raw }}, { maximumFractionDigits: 3 }), alignment: 'right' },
                            { stack: [
                                { text: pdf.wrap("{{ payment.payments_comment|escape('js') }}") },
                                { text: pdf.wrap("{{ payment.payments_supplier|escape('js') }}"), style: 'muted' }
                            ] },
                            {% if GET.prices %}
                                { text: "{{ payment.payments_amount|pdfMoney|escape('js') }}", alignment: 'right' },
                                { text: "{{ payment.payments_amountTotal|pdfMoney|escape('js') }}", alignment: 'right' },
                            {% endif %}
                        ],
                    {% endfor %}
                    ]),
                {% if GET.prices %}
                    { text: "Summe: {{ entries.total|pdfMoney|escape('js') }}", bold: true, alignment: 'right' },
                {% endif %}
            {% endif %}
        {% endfor %}
    );

    if (data.type === 'deliveryNote') content.push({
        unbreakable: true,
        stack: [
            pdf.heading('Empfang bestätigt'),
            { columns: [
                { text: '____________________\nDatum', width: pdf.mm(55) },
                { text: '________________________________________\nName und Unterschrift', width: '*' }
            ], margin: [0, 10, 0, 0] }
        ]
    });
    const doc = letter.definition(source, data, content);
    if (data.draft) doc.watermark = { text: 'ENTWURF', opacity: .14, bold: true, italics: false };

    const filename = pdf.filename(data.title, invoice?.number, data.project, data.draft ? 'Entwurf' : (!invoice && data.save ? 'v' + data.version : ''));
    if (!data.save) {
        pdf.downloadPage(doc, filename, 'project-');
        return;
    }
    const status = document.getElementById('project-pdf-status');
    const error = document.getElementById('project-pdf-error');
    const fail = failure => {
        status.textContent = '';
        error.textContent = failure.message;
    };
    const issue = document.getElementById('project-pdf-issue');
    function save() {
        if (issue) issue.disabled = true;
        error.textContent = '';
        status.textContent = 'PDF wird erstellt …';
        try {
            pdf.create(doc).getBlob(async blob => {
                try {
                    const form = new FormData();
                    form.append('file', blob, filename);
                    form.append('type', data.type);
                    form.append('id', data.projectId);
                    form.append('fileNumber', data.version);
                    if (data.token) form.append('invoiceToken', data.token);
                    const response = await fetch(data.upload, { method: 'POST', body: form });
                    const result = await response.json();
                    if (!response.ok || !result.result) throw new Error(result.error?.message || 'Das PDF konnte nicht gespeichert werden.');
                    if (issue) issue.hidden = true;
                    pdf.showDownload(blob, filename, 'project-', true);
                } catch (failure) {
                    if (issue) issue.disabled = false;
                    fail(failure);
                }
            });
        } catch (failure) {
            if (issue) issue.disabled = false;
            fail(failure);
        }
    }
    if (issue) {
        status.textContent = 'Die Rechnungsangaben sind vollständig. Bestätige das Speichern, um die Rechnung auszustellen.';
        issue.onclick = save;
    } else save();
})();
</script>
</body>
</html>
