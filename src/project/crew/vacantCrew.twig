{% extends "assets/template.twig" %}
{% block content %}

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-pills">
                        <li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/project/?id={{project.projects_id}}#details-view"><i class="fas fa-arrow-left"></i> Zurück zu <span style="font-weight:bold;">{{project.projects_name}}</span></a></li>
                    </ul>
                </div>
            </div>
            <div class="card ">
                <div class="card-header">
                    <h3 class="card-title">
                        Ausgeschriebene Crew-Stellen
                    </h3>
                    <div class="card-tools pull-right">
                        <form class="input-group input-group-sm" method="GET">
                            <div class="input-group-append">
                                <button type="button" class="btn btn-default" data-toggle="modal" data-target="#editModalNEW"><i class="fa fa-plus"></i></button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="card-body table-responsive p-0">
                    <table class="table table-striped">
                        <thead>
                        <tr>
                            <th style="width: 20%">
                                Rollenname
                            </th>
                            <th>
                                Status
                            </th>
                            <th>
                                Frist
                            </th>
                            <th>
                                Besetzte Plätze / Gesamtzahl
                            </th>
                            <th>
                                Bewerbungen
                            </th>
                            <th style="width: 20px">
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for role in roles %}
                            <tr>
                                <td>
                                    {{ role.projectsVacantRoles_name }}
                                </td>
                                <td>
                                    {% if role.projectsVacantRoles_slotsFilled >= role.projectsVacantRoles_slots %}
                                        <p class="badge badge-info" data-toggle="tooltip" data-placement="right" title="Alle Stellen sind besetzt">Besetzt</p>
                                    {% elseif role.projects_dates_use_end and date(role.projects_dates_use_end) < date() %}
                                        <p class="badge badge-warning" data-toggle="tooltip" data-placement="right" title="Das Projektende ist verstrichen">Projekt beendet</p>
                                    {% elseif role.projectsVacantRoles_deadline and date(role.projectsVacantRoles_deadline) < date() %}
                                        <p class="badge badge-warning" data-toggle="tooltip" data-placement="right" title="Die Bewerbungsfrist ist verstrichen">Frist abgelaufen</p>
                                    {% elseif role.projectsVacantRoles_open == 1 %}
                                        <p class="badge badge-success" data-toggle="tooltip" data-placement="right" title="Sichtbar und für Bewerbungen geöffnet">Offen</p>
                                    {% else %}
                                        <p class="badge badge-secondary" data-toggle="tooltip" data-placement="right" title="Für die Crew ausgeblendet">Ausgeblendet</p>
                                    {% endif %}
                                </td>
                                <td>
                                    {{ role.projectsVacantRoles_deadline ? role.projectsVacantRoles_deadline|date("d.m.Y H:i") : '' }}
                                </td>
                                <td>
                                    {{ role.projectsVacantRoles_slotsFilled }}/{{ role.projectsVacantRoles_slots }}
                                </td>
                                <td>
                                    {{ role.applications }}
                                </td>
                                <td class="project-actions text-right">
                                    <div class="btn-group">
                                        {% if role.applications > 0 %}
                                            <a class="btn btn-success btn-sm{% if role.canViewApplications != true %} disabled" href="#" title="Du darfst die Bewerbungen nicht ansehen."{% else %}" href="applications.php?id={{ role.projectsVacantRoles_id }}"{% endif %}>Applications</a>
                                        {% endif %}
                                        <button type="button" class="btn btn-default btn-sm" data-toggle="modal" data-target="#editModal{{ role.projectsVacantRoles_id }}"><i class="fas fa-edit"></i></button>
                                        {% if role.applications < 1 %}
                                        <button type="button" class="btn btn-danger btn-sm deleteButton" data-id="{{ role.projectsVacantRoles_id }}"><i class="fas fa-trash"></i></button>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {% if roles %}
            {% set  roles = roles|merge([{ "NEW": true, "projectsVacantRoles_id": "NEW" }]) %}
        {% else %}
            {% set roles = [{ "NEW": true, "projectsVacantRoles_id": "NEW" }] %}
        {% endif %}
        {% for role in roles %}
        <div class="modal fade" id="editModal{{ role.projectsVacantRoles_id }}">
            <div class="modal-dialog  modal-lg">
                <form class="editForm" data-id="{{ role.projectsVacantRoles_id }}">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="modal-title">Vacancy</h4>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Schließen">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="projects_id" value="{{ project.projects_id }}"/>
                            <input type="hidden" name="projectsVacantRoles_id" value="{{ role.projectsVacantRoles_id }}"/>
                            <div class="input-group" style="margin-bottom: 5px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Name</span>
                                </div>
                                <input required type="text" class="form-control" placeholder="Bedienung der Drehbühne" name="projectsVacantRoles_name" value="{{ role.projectsVacantRoles_name }}">
                            </div>
                            <div class="input-group" style="margin-bottom: 5px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Beschreibung</span>
                                </div>
                                <textarea type="text" required class="form-control" name="projectsVacantRoles_description" placeholder="Beispiel: Einsatz von 09:00 bis 23:00 Uhr mit den vorgesehenen Pausen. Wegen Kundenkontakts ist Dienstkleidung erforderlich." rows="6">{{ role.projectsVacantRoles_description }}</textarea>
                            </div>
                            <div class="input-group" style="margin-bottom: 5px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Person Specification</span>
                                </div>
                                <textarea type="text" class="form-control" placeholder="Beispiel: Erfahrung mit Drehbühnen erforderlich. Eine passende Qualifikation ist von Vorteil." name="projectsVacantRoles_personSpecification" rows="6">{{ role.projectsVacantRoles_personSpecification }}</textarea>
                            </div>
                            <hr/>
                            <div class="input-group" style="margin-bottom: 5px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Bewerbungsfrist</span>
                                </div>
                                <input type="text" class="form-control float-right deadlineDatePicker" name="projectsVacantRoles_deadline" value="{{ (role.projectsVacantRoles_deadline ? role.projectsVacantRoles_deadline|date("j M Y h:i:sa") : '') }}">
                            </div>
                            <div class="input-group" style="margin-bottom: 5px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Offene Stellen</span>
                                </div>
                                <input type="number" class="form-control" required name="projectsVacantRoles_slots" min="1" value="{{ role.projectsVacantRoles_slots }}" />
                            </div>
                            <div class="input-group" style="margin-bottom: 5px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" data-toggle="tooltip" data-placement="bottom" title="Selbsteintragung erlauben und die Stelle automatisch schließen, sobald sie besetzt ist.">
                                        First Come First Served
                                    </span>
                                </div>
                                <input type="checkbox" class="form-control" name="projectsVacantRoles_firstComeFirstServed" {{ role.projectsVacantRoles_firstComeFirstServed == 1 ? 'checked' : ''  }}  />
                            </div>
                            <hr/>
                            <h3>Zugriff auf Bewerbungen</h3>
                            <div class="input-group" style="margin-bottom: 5px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Bewerbungen nur für die Projektleitung sichtbar</span>
                                </div>
                                <input type="checkbox" class="form-control" name="projectsVacantRoles_privateToPM" {{ project.projects_manager == USERDATA.users_userid or role.NEW ? '' : 'disabled' }} {{ role.projectsVacantRoles_privateToPM == 1 ? 'checked' : (role.NEW ? 'checked')  }}  />
                            </div>
                            <div class="form-group">
                                <label>Bewerbungen nur diesen Benutzern anzeigen:</label>
                                <select multiple class="form-control select2 select2bs4" {{ project.projects_manager == USERDATA.users_userid or role.NEW ? '' : 'disabled' }} name="projectsVacantRoles_applicationVisibleToUsers">
                                    {% for user in users %}
                                        <option value="{{ user.users_userid }}" {% if user.users_userid in role.projectsVacantRoles_applicationVisibleToUsers|split(',') %}selected{% endif %}>{{ user.users_name1 ~ " " ~ user.users_name2 }}</option>
                                    {% endfor %}
                                </select>
                                <small class="form-text text-muted">Wenn nur die Projektleitung Bewerbungen sehen darf, wird diese Liste ignoriert. Ohne Einschränkung können alle Benutzer die Bewerbungen sehen.</small>
                            </div>
                            <small class="form-text text-muted">Nach dem Anlegen der Stelle kann nur die Projektleitung diese Einstellungen ändern.</small>
                            <hr/>
                            <h3>Sichtbarkeit der Stelle</h3>
                            <div class="input-group" style="margin-bottom: 5px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">In der Liste offener Crew-Stellen anzeigen</span>
                                </div>
                                <input type="checkbox" class="form-control" name="projectsVacantRoles_open" {{ role.projectsVacantRoles_open == 1 or role.NEW ? 'checked' : ''  }}  />
                            </div>
                            <div class="input-group" style="margin-bottom: 5px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Auf der öffentlichen Seite anzeigen</span>
                                </div>
                                <input type="checkbox" class="form-control" name="projectsVacantRoles_showPublic" {% if publicData.enabled != true %}disabled title="Öffentliche Seite ist deaktiviert"{% elseif role.projectsVacantRoles_visibleToGroups != null %}disabled title="Die Rolle steht nur den ausgewählten Gruppen offen."{% elseif role.projectsVacantRoles_showPublic == 1 or role.NEW %}checked{% endif %} />
                            </div>
                            <div class="form-group">
                                <label>Nur für diese Rollengruppen sichtbar:</label>
                                <select multiple class="form-control select2 select2bs4" name="projectsVacantRoles_visibleToGroups">
                                    {% for position in positions %}
                                        <option value="{{ position.instancePositions_id }}" {% if position.instancePositions_id in role.projectsVacantRoles_visibleToGroups|split(',') %}selected{% endif %}>{{ position.instancePositions_displayName }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <hr/>
                            <div class="input-group" style="margin-bottom: 5px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Telefonnummern abfragen</span>
                                </div>
                                <input type="checkbox" class="form-control" name="projectsVacantRoles_collectPhone" {{ role. projectsVacantRoles_collectPhone == 1 or role.NEW ? 'checked' : ''  }}  />
                            </div>
                            <div class="input-group" style="margin-bottom: 5px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Dateianhänge bei Bewerbungen erlauben</span>
                                </div>
                                <input type="checkbox" class="form-control" name="projectsVacantRoles_fileUploads" {{ role.projectsVacantRoles_fileUploads == 1 or role.NEW ? 'checked' : ''  }}  />
                            </div>
                            <br/>
                            <div class="applicationQuestions" data-id="{{ role.projectsVacantRoles_id }}">
                                <button type="button" class="btn btn-secondary applicationQuestionsAddButton mb-2">Bewerbungsfrage hinzufügen</button>
                                {% for question in role.projectsVacantRoles_questionsArray %}
                                    <div class="applicationQuestions-group">
                                        <div class="input-group" style="margin-bottom: 5px;">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">Fragetext</span>
                                            </div>
                                            <input type="text" class="form-control" data-name="name" value="{{ question.name }}" />
                                        </div>
                                        <div class="input-group" style="margin-bottom: 5px;">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">Platzhalter</span>
                                            </div>
                                            <input type="text" class="form-control" data-name="placeholder" value="{{ question.placeholder }}" />
                                        </div>
                                        <div class="input-group" style="margin-bottom: 5px;">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">Hinweise</span>
                                            </div>
                                            <textarea class="form-control">{{ question.notes }}</textarea>
                                        </div>
                                        <div class="input-group" style="margin-bottom: 5px;">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">Fragetyp</span>
                                            </div>
                                            <select class="form-control">
                                                <option value="textarea" {{ question.type == "textarea" ? 'selected' }}>Mehrzeiliger Text</option>
                                                <option value="text" {{ question.type == "text" ? 'selected' }}>Einzeiliger Text</option>
                                            </select>
                                        </div>
                                    </div><hr/>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="modal-footer justify-content-between">
                            <button type="button" class="btn btn-default" data-dismiss="modal">Schließen</button>
                            <button type="submit" class="btn btn-primary saveEdit">Speichern</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    {% endfor %}
    <script>
        $(document).ready(function () {
            $('input.deadlineDatePicker').daterangepicker({
                singleDatePicker: true,
                timePicker: true,
                timePickerIncrement: 15,
                locale: {
                    ...adamDatePickerLabels,
                    format: 'DD MMM YYYY hh:mm A',
                    cancelLabel: 'Clear'
                },
                autoUpdateInput: false
            });
            $('input.deadlineDatePicker').on('apply.daterangepicker', function(ev, picker) {
                $(this).val(picker.startDate.format('DD MMM YYYY hh:mm A'));
            });

            $('input.deadlineDatePicker').on('cancel.daterangepicker', function(ev, picker) {
                $(this).val('');
            });
            $('.editForm .select2').select2({
                theme: "bootstrap4",
                width: '100%'
            });
            $('[data-toggle="tooltip"]').tooltip()
                
            $(".applicationQuestionsAddButton").click(function () {
                $(this).parent().append(`<div class="applicationQuestions-group">
                                        <div class="input-group" style="margin-bottom: 5px;">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">Fragetext</span>
                                            </div>
                                            <input type="text" class="form-control" data-name="name" />
                                        </div>
                                        <div class="input-group" style="margin-bottom: 5px;">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">Platzhalter</span>
                                            </div>
                                            <input type="text" class="form-control" data-name="placeholder" />
                                        </div>
                                        <div class="input-group" style="margin-bottom: 5px;">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">Hinweise</span>
                                            </div>
                                            <textarea class="form-control"></textarea>
                                        </div>
                                        <div class="input-group" style="margin-bottom: 5px;">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">Fragetyp</span>
                                            </div>
                                            <select class="form-control">
                                                <option value="textarea">Mehrzeiliger Text</option>
                                                <option value="text" selected>Einzeiliger Text</option>
                                            </select>
                                        </div>
                                    </div><hr/>`);
            });


            $(".editForm").submit(function (event) {
                var formData = $(".editForm[data-id=" + $(this).data("id") + "]").serializeArray();

                var questions = [];
                $( '.applicationQuestions[data-id="'  + $(this).data("id") +  '"] > .applicationQuestions-group').each(function( index ) {
                    if ($(this).find("input[data-name='name']").val() != "") {
                        questions.push({
                            "name": $(this).find("input[data-name='name']").val(),
                            "notes": $(this).find("textarea").val(),
                            "type": $(this).find("select").val(),
                            "placeholder": $(this).find("input[data-name='placeholder']").val(),
                        });
                    }
                });
                formData.push({"name": "projectsVacantRoles_questions", "value":JSON.stringify(questions)});

                event.preventDefault();
                ajaxcall("projects/crew/crewRoles/edit.php", {formData}, function (data) {
                    location.reload();
                });
            });
            $(".deleteButton").click(function () {
                var id = $(this).data("id");
                bootbox.confirm({
                    message: "Diese Rolle löschen?",
                    buttons: {
                        confirm: {
                            label: 'Ja',
                            className: 'btn-danger'
                        },
                        cancel: {
                            label: 'Nein',
                            className: 'btn-success'
                        }
                    },
                    callback: function (result) {
                        if (result) {
                            var formData = [{"name": "projects_id", "value":"{{ project.projects_id }}" },{"name": "projectsVacantRoles_id", "value":id },{"name": "projectsVacantRoles_deleted", "value":"1" }];
                            ajaxcall("projects/crew/crewRoles/edit.php", {formData}, function (data) {
                                location.reload();
                            });
                        }
                    }
                });
            });
        });
    </script>
    </div>

{% endblock %}
