<div class="row">
	<div class="col-lg-6 col-md-6 col-sm-12">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">Übersicht</h3>
			</div>
			<div class="card-body p-0">
				<table class="table">
					<tr>
						<td style="width: 35%;">
							Material vor Rabatt
						</td>
						<td class="text-nowrap" style="width: 15%;text-align: right;">
							{{ FINANCIALS.prices.subTotal|money }}
						</td>
						<td style="width: 35%;">
							Verkäufe
						</td>
						<td class="text-nowrap" style="width: 15%;text-align: right;">
							{{ FINANCIALS.payments.sales.total|money }}
						</td>
					</tr>
					<tr>
						<td style="width: 35%;">
							{% if FINANCIALS.prices.discounts|moneyPositive %}Rabatte{% else %}Anpassungen
							{% endif %}
						</td>
						<td class="text-nowrap" style="width: 15%;text-align: right;">
							{% if FINANCIALS.prices.discounts|moneyPositive %}&#8209;{{ FINANCIALS.prices.discounts|money }}{% else %}Keine
							{% endif %}
						</td>
						<td style="width: 35%;">
							Personal
						</td>
						<td class="text-nowrap" style="width: 15%;text-align: right;">
							{{ FINANCIALS.payments.staff.total|money }}
						</td>
					</tr>
					<tr>
						<td style="width: 35%;">
							<b>Material gesamt</b>
						</td>
						<td class="text-nowrap" style="width: 15%;text-align: right;">
							{{ FINANCIALS.prices.total|money }}
						</td>
						<td style="width: 35%;">
							Zumietungen
						</td>
						<td class="text-nowrap" style="width: 15%;text-align: right;">
							{{ FINANCIALS.payments.subHire.total|money }}
						</td>
					</tr>
					<tr style="background-color: rgba(0,0,0,.03);">
                        <td style="width: 35%;"></td>
						<td class="text-nowrap" style="width: 15%;text-align: right;"></td>
						<td style="width: 35%;">
							<b>Zwischensumme</b>
						</td>
						<td class="text-nowrap" style="width: 15%;text-align: right;">
							{{ FINANCIALS.payments.subTotal|money }}
						</td>
					</tr>
                    <tr>
						<td style="width: 35%;"></td>
						<td style="width: 10%;"></td>
						<td style="width: 40%;">
							Bisherige Zahlungseingänge
						</td>
						<td class="text-nowrap" style="width: 15%;text-align: right;">
							&#8209;{{ FINANCIALS.payments.received.total|money }}
						</td>
					</tr>
					<tr>
						<td style="width: 35%;"></td>
						<td class="text-nowrap" style="width: 15%;text-align: right;"></td>
						<td style="width: 35%;">
							<b>Offener Betrag</b>
						</td>
						<td class="text-nowrap" style="width: 15%;text-align: right;">
							{{ FINANCIALS.payments.total|money }}
						</td>
					</tr>
				</table>
			</div>
			<div class="card-footer">
				<div class="btn-group float-right">
					<a href="{{ CONFIG.LINKS_USERGUIDEURL }}projects/finance" target="_blank" type="button" class="btn btn-info">Hilfe</a>

					{% if "PROJECTS:PROJECT_PAYMENTS:CREATE"|instancePermissions %}
						<button type="button" class="btn btn-default newPayment" data-type="1">Zahlungseingang erfassen</button>
						<button type="button" class="btn btn-default dropdown-toggle dropdown-icon" data-toggle="dropdown">
							<span class="sr-only">Auswahl öffnen</span>
							<div class="dropdown-menu" role="menu">
								<a class="dropdown-item newPayment" data-type="2" href="#">Verkaufsposition hinzufügen</a>
								<a class="dropdown-item newPayment" data-type="3" href="#">Zumietung hinzufügen</a>
								<a class="dropdown-item newPayment" data-type="4" href="#">Personalkosten hinzufügen</a>
							</div>
						</button>
					{% endif %}
				</div>
			</div>
		</div>

	</div>
	<div class="col-lg-6 col-md-6 col-sm-12">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">Abrechnungshinweise</h3>
			</div>
			<div class="card-body">
				{% if project.projects_invoiceNotes|nl2br %}
					{{ project.projects_invoiceNotes|nl2br }}
				{% else %}
					<i>Keine Angabe</i>
				{% endif %}
			</div>
            {% if "PROJECTS:EDIT:INVOICE_NOTES"|instancePermissions %}
			<div class="card-footer">
				<div class="btn-group float-right">
                    <button type="button" class="btn btn-default editProjectInvoiceNotes" title="Bearbeiten">Abrechnungshinweise bearbeiten</button>
				</div>
			</div>
            {% endif %}
		</div>
        <div class="card">
			<div class="card-header">
				<h3 class="card-title">Lieferscheine</h3>
			</div>
			<div class="card-body">
				{% if project.projects_deliveryNotes|nl2br %}
					{{ project.projects_deliveryNotes|nl2br }}
				{% else %}
					<i>Keine Angabe</i>
				{% endif %}
			</div>
            {% if "PROJECTS:EDIT:DELIVERY_NOTES"|instancePermissions %}
			<div class="card-footer">
				<div class="btn-group float-right">
                    <button type="button" class="btn btn-default editProjectDeliveryNotes" title="Bearbeiten">Lieferhinweise bearbeiten</button>
				</div>
			</div>
            {% endif %}
		</div>
	</div>
</div>
<div class="row">
	<div class="col-lg-6 col-md-6 col-sm-12">
		{% if FINANCIALS.payments.sales.ledger %}
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">Verkäufe</h3>
				</div>
				<div class="card-body p-0">
					<table class="table table-bordered">
						<thead>
							<tr>
								<th>Menge</th>
								<th style="width: 100%;">Beschreibung</th>
								<th>Betrag</th>
								<th>Gesamt</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{% set currentSupplier = "" %}
							{% for payment in FINANCIALS.payments.sales.ledger %}
								{% if currentSupplier != payment.payments_supplier %}
									{% set currentSupplier = payment.payments_supplier %}
									{% if payment.payments_supplier != "" %}
										<tr>
											<td colspan="99" style="background-color: #F5F5F5;">
												<b>{{ payment.payments_supplier }}</b>
											</td>
										</tr>
									{% endif %}
								{% endif %}
								<tr>
									<td style="width: 10px;">{{ payment.payments_quantity }}x</td>
									<td>{{ payment.payments_comment|nl2br }}</td>
									<td style="width:100px;">{{ payment.payments_amount|money }}</td>
									<td style="width:100px;text-align: right;">{{ payment.payments_amountTotal|money }}</td>
									<td>
										{% if  CONFIG.FILES_ENABLED == "Enabled" and "PROJECTS:PROJECT_PAYMENTS:VIEW:FILE_ATTACHMENTS"|instancePermissions %}
											<button data-toggle="modal" data-target="#filesModal{{ payment.payments_id }}" type="button" class="btn btn-outline-secondary btn-sm">{{ (payment.files|length > 0 ? payment.files|length ~ '&nbsp;' : '')|raw }}<i class="fas fa-paperclip" style="display:inline;"></i>
											</button>
										{% endif %}
										{% if "PROJECTS:PROJECT_PAYMENTS:DELETE"|instancePermissions %}
											<button title="Löschen" class="btn btn-sm btn-danger deletePaymentButton" data-paymentid="{{ payment.payments_id }}">
												<i class="fa fa-trash"></i>
											</button>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		{% endif %}
		{% if FINANCIALS.payments.subHire.ledger %}
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">Zumietungen</h3>
				</div>
				<div class="card-body p-0">
					<table class="table table-bordered">
						<thead>
							<tr>
								<th>Menge</th>
								<th style="width: 100%;">Beschreibung</th>
								<th>Betrag</th>
								<th>Gesamt</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{% set currentSupplier = "" %}
							{% for payment in FINANCIALS.payments.subHire.ledger %}
								{% if currentSupplier != payment.payments_supplier %}
									{% set currentSupplier = payment.payments_supplier %}
									{% if payment.payments_supplier != "" %}
										<tr>
											<td colspan="99" style="background-color: #F5F5F5;">
												<b>{{ payment.payments_supplier }}</b>
											</td>
										</tr>
									{% endif %}
								{% endif %}
								<tr>
									<td style="width: 10px;">{{ payment.payments_quantity }}x</td>
									<td>{{ payment.payments_comment|nl2br }}</td>
									<td style="width:100px;">{{ payment.payments_amount|money }}</td>
									<td style="width:100px;text-align: right;">{{ payment.payments_amountTotal|money }}</td>
									<td>
										{% if CONFIG.FILES_ENABLED == "Enabled" and "PROJECTS:PROJECT_PAYMENTS:VIEW:FILE_ATTACHMENTS"|instancePermissions %}
											<button data-toggle="modal" data-target="#filesModal{{ payment.payments_id }}" type="button" class="btn btn-outline-secondary btn-sm">{{ (payment.files|length > 0 ? payment.files|length ~ '&nbsp;' : '')|raw }}<i class="fas fa-paperclip" style="display:inline;"></i>
											</button>
										{% endif %}
										{% if "PROJECTS:PROJECT_PAYMENTS:DELETE"|instancePermissions %}
											<button title="Löschen" class="btn btn-sm btn-danger deletePaymentButton" data-paymentid="{{ payment.payments_id }}">
												<i class="fa fa-trash"></i>
											</button>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		{% endif %}
		{% if FINANCIALS.payments.staff.ledger %}
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">Personal</h3>
				</div>
				<div class="card-body p-0">
					<table class="table table-bordered">
						<thead>
							<tr>
								<th>Menge</th>
								<th>Lieferant</th>
								<th style="width: 100%;">Beschreibung</th>
								<th>Betrag</th>
								<th>Gesamt</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{% for payment in FINANCIALS.payments.staff.ledger %}
								<tr>
									<td style="width: 10px;">{{ payment.payments_quantity }}x</td>
									<td>{{ payment.payments_supplier|nbsp}}</td>
									<td>{{ payment.payments_comment|nl2br }}</td>
									<td style="width:100px;">{{ payment.payments_amount|money }}</td>
									<td style="width:100px;text-align: right;">{{ payment.payments_amountTotal|money }}</td>
									<td>
										{% if CONFIG.FILES_ENABLED == "Enabled" and "PROJECTS:PROJECT_PAYMENTS:VIEW:FILE_ATTACHMENTS"|instancePermissions %}
											<button data-toggle="modal" data-target="#filesModal{{ payment.payments_id }}" type="button" class="btn btn-outline-secondary btn-sm">{{ (payment.files|length > 0 ? payment.files|length ~ '&nbsp;' : '')|raw }}<i class="fas fa-paperclip" style="display:inline;"></i>
											</button>
										{% endif %}
										{% if "PROJECTS:PROJECT_PAYMENTS:DELETE"|instancePermissions %}
											<button title="Löschen" class="btn btn-sm btn-danger deletePaymentButton" data-paymentid="{{ payment.payments_id }}">
												<i class="fa fa-trash"></i>
											</button>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		{% endif %}
	</div>
	<div class="col-lg-6 col-md-6 col-sm-12">
		{% if FINANCIALS.payments.received.ledger %}
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">Zahlungseingänge</h3>
				</div>
				<div class="card-body p-0">
					<table class="table table-bordered">
						<thead>
							<tr>
								<th>Referenz</th>
								<th>Datum</th>
								<th>Zahlungsart</th>
								<th>Kommentar</th>
								<th>Betrag</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{% for payment in FINANCIALS.payments.received.ledger %}
								<tr>
									<td>{{ payment.payments_reference }}</td>
									<td>{{ payment.payments_date|date("d.m.Y H:i:s") }}</td>
									<td>{{ payment.payments_method }}</td>
									<td>{{ payment.payments_comment|nl2br }}</td>
									<td>{{ payment.payments_amount|money }}</td>
									<td>
										{% if  CONFIG.FILES_ENABLED == "Enabled" and "PROJECTS:PROJECT_PAYMENTS:VIEW:FILE_ATTACHMENTS"|instancePermissions %}
											<button data-toggle="modal" data-target="#filesModal{{ payment.payments_id }}" type="button" class="btn btn-outline-secondary btn-sm">{{ (payment.files|length > 0 ? payment.files|length ~ '&nbsp;' : '')|raw }}<i class="fas fa-paperclip" style="display:inline;"></i>
											</button>
										{% endif %}
										{% if "PROJECTS:PROJECT_PAYMENTS:DELETE"|instancePermissions %}
											<button title="Löschen" class="btn btn-sm btn-danger deletePaymentButton" data-paymentid="{{ payment.payments_id }}">
												<i class="fa fa-trash"></i>
											</button>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		{% endif %}
	</div>
</div>
