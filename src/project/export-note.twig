<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <title>Projektnotiz - {{ note.projectsNotes_title }} - {{ project.projects_name }}</title>
    <link rel="stylesheet" href="{{ CONFIG.ROOTURL }}/static-assets/css/pdfPrint.css">
    <script>window.addEventListener('load', () => window.print());</script>
</head>
<body class="pdf-print-report">
    <header class="pdf-print-header">
        {% if USERDATA.instance.instances_logo %}
            <img src="{{ USERDATA.instance.instances_logo|s3URL('medium') }}" alt="Firmenlogo">
        {% endif %}
        <p>{{ USERDATA.instance.instances_name }}</p>
        <h1>{{ note.projectsNotes_title }}</h1>
        <p>Projektnotiz · {{ project.projects_name }} · Projekt-Nr. {{ project.projects_id }}</p>
    </header>
    <main class="pdf-print-content">{{ note.projectsNotes_text|raw }}</main>
    <footer class="pdf-print-footer">
        <div>Exportiert am {{ 'now'|date('d.m.Y, H:i', 'Europe/Berlin') }} · {{ CONFIG.PROJECT_NAME }}</div>
        <div>{{ [USERDATA.instance.instances_phone, USERDATA.instance.instances_email, USERDATA.instance.instances_website]|filter(value => value)|join(' · ') }}</div>
    </footer>
</body>
</html>
