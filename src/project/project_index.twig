    <script>
        $(document).ready(function () {
            $('#pdfGenerateModal').on('show.bs.modal', function (e) {
                 if ($(e.relatedTarget).data('delivery-note')){
                    $("#pdfGenerateModal .modal-title").text("Lieferschein erstellen");
                    $('#pdfGenerateModal input[name="type"]').val("deliveryNote");
                    $('#pdfGenerateModal input[name="finance"]').prop('checked', false).parent().hide();
                    $('#pdfGenerateModal input[name="prices"]').prop('checked', false).parent().hide();
                    $('#pdfGenerateModal input[name="discounts"]').prop('checked', false).parent().hide();
                    $('#pdfGenerateModal input[name="flagsBlocks"]').prop('checked', false).parent().hide();
                } else {
                    $('#pdfGenerateModal input[name="finance"]').prop('checked', true).parent().show();
                    $('#pdfGenerateModal input[name="prices"]').prop('checked', true).parent().show();
                    $('#pdfGenerateModal input[name="discounts"]').prop('checked', true).parent().show();
                    $('#pdfGenerateModal input[name="flagsBlocks"]').prop('checked', false).parent().show();
                    if ($(e.relatedTarget).data('quote')) {
                        $("#pdfGenerateModal .modal-title").text("Angebot erstellen");
                        $('#pdfGenerateModal input[name="type"]').val("quote");
                    } else {
                        $("#pdfGenerateModal .modal-title").text("Rechnung erstellen");
                        $('#pdfGenerateModal input[name="type"]').val("invoice");
                    }
                }
                const invoice = this.querySelector('input[name="type"]').value === 'invoice';
                const fields = document.getElementById('invoice-pdf-fields');
                fields.hidden = !invoice;
                fields.disabled = !invoice;
            });
            $("#assetAssignmentCheckboxAll").click(function () {
                $(".assetAssignmentCheckbox").prop('checked', $(this).prop('checked'));
            });
            function quickCommentEditor(commentId, content) {
                var editor = $('<div></div>');
