{% for kind, title in {'stage': 'Bühnenplanung', 'shift': 'Schichtplanung'} %}
<div class="tab-pane" id="{{ kind }}-planning-view">
    {% if kind == 'shift' %}
        {% if 'PROJECTS:PROJECT_CREW:VIEW'|instancePermissions %}
            {% include 'project/twigIncludes/shiftPlanning.twig' %}
        {% endif %}
    {% else %}
        <div class="card">
            <div class="card-header d-flex flex-wrap align-items-center">
                <h3 class="card-title mr-auto">{{ title }} <small class="text-muted ml-2">{{ project.projects_name }}</small></h3>
                <a class="btn btn-primary btn-sm" href="https://ridermaker.com" target="_blank" rel="noopener noreferrer">In neuem Tab öffnen <i class="fas fa-external-link-alt ml-1"></i></a>
            </div>
            <div class="card-body">
                <h4>Bühne mit Ridermaker planen</h4>
                <p>Öffne Ridermaker in einem neuen Tab, exportiere deinen Bühnenplan oder Technical Rider und lade die Datei unten hoch.</p>
                <p class="text-muted mb-0">Hochgeladene Dateien erscheinen auch im Reiter „Dateien“ des Projekts. Änderungen im externen Editor musst du erneut hochladen.</p>
            </div>
        </div>
    {% endif %}
    <div class="card" id="{{ kind }}-planning-files">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between">
            <h3 class="card-title">Dateien zur {{ title }}</h3>
            {% if kind == 'shift' %}
                <a class="btn btn-default btn-sm ml-auto" href="https://www.onlinegantt.com/#/gantt" target="_blank" rel="noopener noreferrer">Online Gantt <i class="fas fa-external-link-alt ml-1"></i></a>
            {% endif %}
        </div>
        {% set planningFilesEnabled = CONFIG.FILES_ENABLED == "Enabled" and USERDATA.instance.instances_storageEnabled == 1 and project.projectsTypes_config_files == 1 %}
        {% if planningFilesEnabled or kind == 'stage' %}
        <div class="card-body">
            {% if planningFilesEnabled %}
                {% set planningItems = kind == 'stage' ? stagePlanningFiles : shiftPlanningFiles %}
                {% if planningItems %}
                    {% include 'assets/templates/fileBox.twig' with {'files': planningItems, 'readOnly': project.projects_archived == 1} %}
                {% else %}<p class="text-muted">Noch keine Planungsdateien vorhanden.</p>{% endif %}
                {% if "PROJECTS:PROJECT_FLIE_ATTACHMENTS:CREATE"|instancePermissions and project.projects_archived != 1 %}
                    {% embed 'assets/templates/uppy.twig' with {'type': 'PROJECT-FILE', 'typeId': 7, 'subTypeId': project.projects_id, 'imagesOnly': false, 'planningCategory': kind, 'planningCsrf': planningCsrf} %}
                        {% block success %}{# The uploader waits for every file registration before refreshing. #}{% endblock %}
                    {% endembed %}
                {% endif %}
            {% else %}
                <p class="text-muted mb-0">Die Dateiablage ist deaktiviert. Aktiviere sie für dieses Unternehmen und den Projekttyp, um Planungsdateien hochzuladen.</p>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>
{% endfor %}
<div class="tab-pane" id="channel-planning-view">
    <div id="channel-planning" data-endpoint="{{ CONFIG.ROOTURL }}/api/projects/channelPlanning.php" data-project="{{ project.projects_id }}" data-editable="{{ ('PROJECTS:CHANNEL_PLANNING:EDIT'|instancePermissions and project.projects_archived != 1) ? '1' : '0' }}">
        <div class="card">
            <div class="card-header d-flex flex-wrap align-items-center">
                <h3 class="card-title mr-auto">Kanalplanung <small class="text-muted ml-2">{{ project.projects_name }}</small></h3>
                <span id="channel-save-status" role="status" aria-live="polite" class="mr-3">Kanalplan wird geladen …</span>
                <button class="btn btn-default btn-sm mr-2" id="channel-configuration" disabled>Konfiguration</button>
                <button class="btn btn-primary btn-sm mr-2" id="channel-save" disabled>Speichern</button>
                <label class="sr-only" for="channel-export-layout">PDF-Layout</label>
                <select class="form-control form-control-sm mr-2" style="width:auto" id="channel-export-layout">
                    <option value="detail">Detailansicht</option>
                    <option value="single">Einblattansicht (A4 Hochformat)</option>
                </select>
                <button class="btn btn-default btn-sm" id="channel-export" data-url="{{ CONFIG.ROOTURL }}/project/channelPlanningExport.php?id={{ project.projects_id }}" disabled>PDF exportieren</button>
            </div>
            <div class="card-body">
                <div id="channel-error" role="alert" class="alert alert-danger" hidden></div>
                <form id="channel-config" class="border rounded p-3 mb-3" hidden>
                    <p id="channel-first-use">Wähle die Anzahl der Eingänge und Ausgänge für den Kanalplan.</p>
                    <div class="form-row align-items-end">
                        <div class="form-group col-sm-3"><label for="channel-input-count">Eingänge</label><input type="number" class="form-control" id="channel-input-count" min="0" max="512" value="32" required></div>
                        <div class="form-group col-sm-3"><label for="channel-output-count">Ausgänge</label><input type="number" class="form-control" id="channel-output-count" min="0" max="256" value="10" required></div>
                        <div class="form-group col-sm-3"><label for="channel-output-labels">Nummerierung der Ausgänge</label><select class="form-control" id="channel-output-labels"><option value="alphabetic">A, B, C…</option><option value="numeric">OUT1, OUT2…</option></select></div>
                        <div class="form-group col-sm-3"><button class="btn btn-primary" type="submit">Konfiguration übernehmen</button></div>
                    </div>
                    <small class="text-muted">Bis zu 512 Eingänge, 256 Ausgänge und 20 Belegungen pro Kanal. Das Entfernen belegter Kanäle erfordert eine Bestätigung.</small>
                </form>
                <label for="channel-search">Kanal, Signal oder Programm suchen</label>
                <input type="search" class="form-control mb-3" id="channel-search" placeholder="Ein- und Ausgänge durchsuchen" disabled>
                <p class="text-muted small" id="channel-edit-help">Trage einen Signalnamen ein, um den Kanal zu belegen. Für ein anderes Programm oder eine andere Szene kannst du eine weitere Belegung anlegen. Änderungen werden automatisch gespeichert.</p>
                <div id="channel-tables"></div>
                <p id="channel-no-results" class="text-muted" hidden>Keine passenden Kanäle.</p>
            </div>
        </div>
    </div>
</div>
<style>
#channel-planning .channel-table{min-width:760px;table-layout:fixed}
#channel-planning .channel-table th{position:sticky;top:0;z-index:1;background:var(--light,#f4f6f9);color:#343a40}
#channel-planning .channel-table td{vertical-align:top;padding:.45rem}
#channel-planning .channel-number{font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
#channel-planning .channel-use{display:grid;grid-template-columns:1fr 1.2fr 1fr 1.2fr auto;gap:.5rem;align-items:start;margin-bottom:.45rem}
#channel-planning textarea{resize:vertical;min-height:38px}
#channel-planning .channel-scroll{max-height:68vh;overflow:auto}
#channel-planning .channel-actions{white-space:nowrap}
#channel-planning [hidden]{display:none!important}
</style>
<script src="{{ CONFIG.ROOTURL }}/project/channelPlanning.js"></script>
