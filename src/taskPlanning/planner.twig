<link rel="stylesheet" href="{{ CONFIG.ROOTURL }}/taskPlanning/planning.css">
<section id="task-planner" data-endpoint="{{ CONFIG.ROOTURL }}/api/taskPlanning/action.php" data-project="{{ taskGlobal ? '' : project.projects_id }}" data-export="{{ CONFIG.ROOTURL }}/taskPlanning/export.php" data-project-url="{{ CONFIG.ROOTURL }}/project/">
    <div class="tp-heading">
        <div><h3>{{ taskGlobal ? 'My Tasks' : 'Task Planning' }}</h3><span id="tp-progress" class="text-muted"></span></div>
        <div class="tp-actions"><button id="tp-packages" class="btn btn-default btn-sm">Aufgabenpakete</button><button id="tp-export-toggle" class="btn btn-default btn-sm">PDF exportieren</button><button id="tp-tick-toggle" class="btn btn-default btn-sm">TickTick</button></div>
    </div>
    <div class="tp-save-line"><span id="tp-save" role="status" aria-live="polite">Aufgaben werden geladen …</span><button id="tp-retry" class="btn btn-link btn-sm" hidden>Speichern erneut versuchen</button><button id="tp-reload" class="btn btn-link btn-sm" hidden>Aktuellen Stand neu laden</button><button id="tp-discard" class="btn btn-link btn-sm" hidden>Ungespeicherte Änderungen verwerfen</button></div>
    <div id="tp-error" class="alert alert-danger" role="alert" hidden></div>
    <div id="tp-export-panel" class="tp-panel" hidden>
        <strong>Aufgabenplan drucken</strong>
        <label>Aufgaben <select id="tp-export-scope" class="form-control form-control-sm"><option value="filtered">Aktuelle Filter</option><option value="all">Alle Aufgaben dieser Ansicht</option></select></label>
        <label>Gruppieren nach <select id="tp-export-group" class="form-control form-control-sm"><option value="category">Kategorie</option><option value="day">Geplanter Tag</option><option value="">Ohne Gruppierung</option></select></label>
        <label><input type="checkbox" id="tp-export-checklist" checked> Checklisten einbeziehen</label>
        <button class="btn btn-primary btn-sm" id="tp-export">PDF exportieren</button>
    </div>
    <div id="tp-tick-panel" class="tp-panel" hidden>
        <strong>TickTick</strong><span id="tp-tick-status"></span>
        {% if "BUSINESS:BUSINESS_SETTINGS:VIEW"|instancePermissions %}<a href="{{ CONFIG.ROOTURL }}/instances/tickTick.php" class="btn btn-default btn-sm">TickTick-Einstellungen</a>{% endif %}
        <button id="tp-connect" class="btn btn-primary btn-sm" disabled>TickTick verbinden</button>
        <button id="tp-disconnect" class="btn btn-default btn-sm" hidden>Verbindung trennen</button>
        {% if not taskGlobal %}<label>Übertragen <select id="tp-sync-scope" class="form-control form-control-sm"><option value="mine">Nur mir zugewiesene Aufgaben</option><option value="all">Alle Projektaufgaben</option></select></label><button id="tp-sync" class="btn btn-primary btn-sm" disabled>Mit TickTick synchronisieren</button>{% endif %}
        <small class="d-block w-100 text-muted">Synchronisiert manuell von AdamRMS nach TickTick. Bestehende Verknüpfungen werden aktualisiert. Kategorie, Status, Zuständigkeit und ursprüngliche Termine stehen auch in der Beschreibung.</small>
    </div>
    <div id="tp-package-panel" class="tp-panel" hidden>
        <div class="tp-actions w-100"><strong class="mr-auto">Wiederverwendbare Aufgabenpakete</strong><select id="tp-package-select" aria-label="Aufgabenpaket" class="form-control form-control-sm"></select><button id="tp-package-new" class="btn btn-default btn-sm">Neues Paket</button><button id="tp-package-from" class="btn btn-default btn-sm">Projektaufgaben als Paket speichern</button><button id="tp-package-edit" class="btn btn-default btn-sm">Paket bearbeiten</button></div>
        <div class="tp-actions w-100" id="tp-package-apply-controls"><label>Bezugsdatum <input id="tp-reference" type="date" class="form-control form-control-sm"></label><button id="tp-preview" class="btn btn-default btn-sm">Paketvorschau</button><span class="text-muted small">Die Tagesabstände beziehen sich auf den Veranstaltungstermin oder auf dieses Bezugsdatum.</span></div>
        <div id="tp-preview-list" class="w-100"></div>
        <button id="tp-apply" class="btn btn-primary btn-sm" hidden>Ausgewählte Aufgaben zum Projekt hinzufügen</button>
        <div id="tp-package-editor" class="w-100" hidden>
            <label class="w-100">Paketname <input id="tp-package-name" class="form-control" maxlength="160"></label>
            <p class="small text-muted">Füge Titel per Eingabetaste oder zeilenweise ein. Klappe eine Aufgabe für Beschreibung und Checkliste auf. Gib Abstände in Tagen ein (−14, −7, −1, 0, +1). Ein leeres Feld bedeutet „ohne Termin“.</p>
            <div id="tp-package-items"></div>
            <textarea id="tp-package-add" rows="2" class="form-control" placeholder="Aufgabentitel eingeben, einer pro Zeile" aria-label="Aufgabentitel des Pakets"></textarea>
            <div class="tp-actions mt-2"><button id="tp-package-add-button" class="btn btn-default btn-sm">Titel hinzufügen</button><button id="tp-package-save" class="btn btn-primary btn-sm">Paket speichern</button><button id="tp-package-cancel" class="btn btn-default btn-sm">Editor schließen</button><button id="tp-package-delete" class="btn btn-outline-danger btn-sm" hidden>Paket löschen</button></div>
        </div>
    </div>
    <div class="card tp-card">
        <div class="tp-filters">
            <input type="search" id="tp-search" class="form-control" placeholder="Aufgaben suchen …" aria-label="Aufgaben suchen">
            <label>Von <input type="date" id="tp-from" class="form-control form-control-sm"></label><label>Bis <input type="date" id="tp-to" class="form-control form-control-sm"></label>
            <select multiple id="tp-categories" aria-label="Nach Kategorien filtern" data-placeholder="Kategorien"></select>
            <select multiple id="tp-assignees" aria-label="Nach Zuständigkeit filtern" data-placeholder="Zuständig"></select>
            <select multiple id="tp-priorities" aria-label="Nach Prioritäten filtern" data-placeholder="Prioritäten"></select>
            <select multiple id="tp-statuses" aria-label="Nach Status filtern" data-placeholder="Status"></select>
            <button id="tp-reset" class="btn btn-link btn-sm">Filter zurücksetzen</button>
        </div>
        <div class="tp-viewbar">
            <label>Sortieren <select id="tp-sort" class="form-control form-control-sm"><option value="manual">Manuell</option><option value="date">Datum</option><option value="priority">Priorität</option><option value="category">Kategorie</option></select></label>
            <label>Gruppe <select id="tp-group" class="form-control form-control-sm"><option value="">Ohne Gruppierung</option><option value="day">Tage</option><option value="category">Kategorien</option></select></label>
            <select id="tp-saved" aria-label="Gespeicherte Filter" class="form-control form-control-sm"><option value="">Gespeicherte Filter …</option></select>
            <input id="tp-filter-name" class="form-control form-control-sm" placeholder="Filtername" maxlength="120" aria-label="Filtername">
            <button id="tp-save-filter" class="btn btn-link btn-sm">Filter speichern</button><button id="tp-delete-filter" class="btn btn-link btn-sm" hidden>Filter löschen</button>
            <span id="tp-shown" class="text-muted ml-auto"></span>
        </div>
        <div id="tp-bulk" class="tp-viewbar" hidden>
            <strong id="tp-selected"></strong><label>Ändern <select id="tp-bulk-field" class="form-control form-control-sm"><option value="status">Status</option><option value="category">Kategorie</option><option value="day">Geplanter Tag</option><option value="assignee">Zuständig</option><option value="priority">Priorität</option></select></label>
            <span id="tp-bulk-value"></span><button id="tp-bulk-apply" class="btn btn-primary btn-sm">Auf Auswahl anwenden</button><button id="tp-bulk-clear" class="btn btn-link btn-sm">Auswahl aufheben</button>
        </div>
        <div id="tp-quick" class="tp-quick" hidden>
            <span class="tp-plus">＋</span>
            {% if taskGlobal %}<select id="tp-quick-project" class="form-control" aria-label="Projekt für neue Aufgaben"></select>{% endif %}
            <textarea id="tp-quick-title" rows="1" class="form-control" placeholder="Aufgabe hinzufügen. Eingabetaste speichert, mehrere Zeilen sind möglich." aria-label="Titel neuer Aufgaben" maxlength="250000"></textarea>
            <button id="tp-add" class="btn btn-primary btn-sm">Hinzufügen</button>
        </div>
        <div class="tp-selectbar"><label><input id="tp-select-all" type="checkbox"> Sichtbare Aufgaben auswählen</label><small id="tp-shortcuts" class="text-muted">N: neue Aufgabe · /: suchen · Eingabe: Titel speichern · Tab: nächstes Feld</small></div>
        <div id="tp-list" aria-label="Aufgaben"></div>
        <div id="tp-empty" class="tp-empty" hidden>Keine passenden Aufgaben. Lege oben eine Aufgabe an oder setze die Filter zurück.</div>
    </div>
    <datalist id="tp-category-list"></datalist>
</section>
<script src="{{ CONFIG.ROOTURL }}/taskPlanning/planning.js"></script>
