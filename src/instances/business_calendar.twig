{% extends "assets/template.twig" %}
{% block content %}
    <div class="row">
        <div class="col-lg-12">
            <div class="card card-primary">
                {% embed 'assets/widgets/calendar.twig' with {"projects": calendarProjects } %} {# Overwite the list of projects from the head funciton, to enable us to sort by location if needed #}
                {% endembed %}
            </div>
        </div>
    </div>

    <div class="card collapsed-card">
        <div class="card-header">
            <h3 class="card-title">Kalender exportieren</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <input type="url" class="form-control" disabled value="{{ CONFIG.ROOTURL }}/api/instances/calendar-export.php?id={{ USERDATA.instance.instances_id }}&key={{ USERDATA.instance.instances_calendarHash }}" />
            <br/>
            <h2>Google Calendar</h2>
            <ol>
                <li>Kopiere die oben angezeigte URL.</li>
                <li><a href="https://calendar.google.com" target="_blank">Öffne Google Kalender</a>, klicke auf das <em>+</em> über <em>Meine Kalender</em> und wähle <em>Per URL</em>.
                </li>
                <li>Füge die URL in das Feld <em>Kalender-URL</em> ein und klicke auf
                    <em>Kalender hinzufügen</em>.
                </li>
                <li>Nach wenigen Sekunden sollte der Kalender erscheinen. Lade Google Kalender bei Bedarf neu.
                </li>
            </ol>
            <h2>Apple Kalender</h2>
            <ol>
                <li>Kopiere die oben angezeigte URL.</li>
                <li>Wähle in Apple Kalender im Menü <em>Datei</em> den Eintrag <em>Neues Kalenderabonnement …</em>.
                </li>
                <li>Füge die URL im Dialog ein und klicke auf <em>Abonnieren</em>.</li>
                <li>Öffne die Einstellungen des Kalenderabonnements und setze <em>Automatisch aktualisieren</em>
                    auf <em>Stündlich</em> . Bestätige mit <em>OK</em>.
                </li>
            </ol>
            <h2>Outlook</h2>
            <ol>
                <li>Kopiere die oben angezeigte URL.</li>
                <li>Klicke in Outlook auf <em>Kalender öffnen</em> und wähle <em>Aus dem Internet …</em>.</li>
                <li>Füge die URL in den Outlook-Dialog ein und klicke auf <em>OK</em>.</li>
                <li>Outlook fragt, ob der Internetkalender hinzugefügt werden soll. Klicke auf <em>Ja</em>.
                </li>
            </ol>
        </div>
    </div>

{% endblock %}