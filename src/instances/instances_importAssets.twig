{% extends "assets/template.twig" %}

{% block content %}
<div class="row">
    <div class="col-lg-6 offset-lg-3 col-md-12" style="padding: 5px;">
        <div class="card px-2">
            <div class="card-header row">
                <h4 class="card-title my-auto">Material importieren</h4>
                <a class="btn btn-info btn-sm ml-auto" href="{{CONFIG.ROOTURL}}/assets/templates/asset-import-template.csv">Vorlage herunterladen</a>
            </div>
            <div class="card-body">
                <p>Lade für den Materialimport eine CSV-Datei mit Komma als Trennzeichen hoch. Verwende die Spaltenüberschriften aus der Vorlage.</p>
                <hr />
                <form class="form" action="{{CONFIG.ROOTURL}}/api/assets/import.php">
                    <div class="form-group">
                        <label for="csvFile">CSV-Datei</label>
                        <input type="file" class="form-control-file" id="csvFile" required>
                    </div>
                    <button type="submit" id="import-upload" class="btn btn-primary">Importieren</button>
                </form>
            </div>
        </div>
        <div class="card" style="display: none;" id="status-card">
            <div class="card-header">
                <h4 class="card-title">Importiertes Material</h4>
            </div>
            <div class="card-body">
                <h5 class="card-subtitle">Angelegte Materialtypen</h5>
                <table class="table">
                    <thead>
                        <th scope="col">Materialtyp-ID</th>
                        <th scope="col">Name des Materialtyps</th>
                    </thead>
                    <tbody id="created-types"></tbody>
                </table>
                <hr/>
                <h5 class="card-subtitle">Hochgeladenes Material</h5>
                <table class="table">
                    <thead>
                        <th scope="col">Zeile</th>
                        <th scope="col">Materialkennung</th>
                        <th scope="col">Materialtyp</th>
                    </thead>
                    <tbody id="uploaded-assets"></tbody>
                </table>
                <hr/>
                <h5 class="card-subtitle">Fehlgeschlagene Importe</h5>
                <table class="table">
                    <thead>
                        <th scope="col">Zeile</th>
                        <th scope="col">Materialkennung</th>
                        <th scope="col">Grund</th>
                    </thead>
                    <tbody id="failed-assets"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#import-upload").click(function (e) {
            e.preventDefault();
            var formData = new FormData();
            formData.append('csvFile', $("#csvFile")[0].files[0]);
            $.ajax({
                url: "{{CONFIG.ROOTURL}}/api/assets/import.php",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (data) {
                    if (data.result) {
                        $("#status-card").show();
                        $("#created-types").empty();
                        $("#uploaded-assets").empty();
                        $("#failed-assets").empty();

                        if (data.response.createdTypes.length == 0) {
                            $("#created-types").append("<tr class='text-center'><td colspan='2'>Keine neuen Materialtypen angelegt</td></tr>");
                        } else {
                            data.response.createdTypes.forEach(element => {
                                $("#created-types").append("<tr><td>" + element.assetTypes_id + "</td><td>" + element.assetTypes_name + "</td></tr>")
                            });
                        }
                        if (data.response.successfulAssets.length == 0) {
                            $("#uploaded-assets").append("<tr class='text-center'><td colspan='3'>Kein Material hochgeladen</td></tr>");
                        } else {
                            data.response.successfulAssets.forEach(element => {
                                $("#uploaded-assets").append("<tr><td>" + element.row + "</td><td>" + element.assets_tag + "</td><td>" + element.assetTypes_id + "</td></tr>")
                            });
                        }
                        
                        if (data.response.failedAssets.length == 0) {
                            $("#failed-assets").append("<tr class='text-center'><td colspan='3'>Das gesamte Material wurde hochgeladen.</td></tr>");
                        } else {
                            data.response.failedAssets.forEach(element => {
                                $("#failed-assets").append("<tr><td>" + element.row + "</td><td>" + element.tag + "</td><td>" + element.reason + "</td></tr>")
                            });
                        }
                        
                    } else {
                        Swal.fire({
                            title: "Error",
                            text: data.error,
                            type: "error",
                            confirmButtonText: "OK"
                        });
                    }
                }
            });
        });
    });
</script>

<div class="row">
    <div class="col-lg-4 offset-lg-4 col-md-12" style="padding: 5px;">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Materialkategorien</h4>
            </div>
            <div class="card-body">
                <h5 class="card-subtitle">Ordne den Namen der gewünschten Kategorie zu.</h5>
                <table class="table">
                    <thead>
                        <th scope="col">Name</th>
                        <th scope="col">Gruppe</th>
                    </thead>
                    <tbody>
                {% for category in categories %}
                    <tr>
                        <td>{{ category.assetCategories_name }}</td>
                        <td>{{ category.assetCategoriesGroups_name }}</td>
                    </tr>
                {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% endblock %}
