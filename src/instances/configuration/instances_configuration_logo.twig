{% extends "assets/template.twig" %}
{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
			<div class="card-header">
				<ul class="nav nav-pills">
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/navigation.php"><i class="fas fa-arrow-left"></i> Zurück zu den Einstellungen</span></a></li>
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/billing.php">Abrechnung</a></li>
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/settings.php">Grundeinstellungen</a></li>
					<li class="nav-item"><a class="nav-link active" href="{{CONFIG.ROOTURL}}/instances/configuration/logo.php">Logo</a></li>
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/public.php">Öffentliche Seite</a></li>
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/calendarSettings.php">Kalendereinstellungen</a></li>
				</ul>
			</div>
		</div>
    </div>
</div>
<div class="row justify-content-center">
    {% if CONFIG.FILES_ENABLED == "Enabled" and USERDATA.instance.instances_storageEnabled == 1 %}
    <div class="col-12 col-md-6">
        <div class="card ">
            <div class="card-header">
                <h3 class="card-title">Logo</h3>
            </div>
            <div class="card-body">
                {% if USERDATA.instance.instances_logo != null %}
                    <img loading="lazy" src="{{ USERDATA.instance.instances_logo|s3URL("medium") }}" style="width: 100%;">
                {% else %}
                    <i>Noch nicht hinterlegt</i>
                {% endif %}
            </div>
            {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
            <div class="card-footer">
                <b>Logos sind öffentlich abrufbar.</b>
                    {% embed 'assets/templates/uppy.twig' with {'publicBool': true, 'type': 'INSTANCE-THUMBNAIL', 'paste': false, 'typeId': 5, 'subTypeId': USERDATA.instance.instances_id, 'fileLimit': 1, 'imagesOnly': true } %}

                    {% block success %}
                        ajaxcall("instances/editInstance.php", {
                            'formData': [{ 'name': 'instances_logo','value':responseJson.id }]
                        }, function (data) {
                            location.reload();
                        });
                    {% endblock %}
                {% endembed %}
            </div>
            {% endif %}
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="card ">
            <div class="card-header">
                <h3 class="card-title">E-Mail-Kopfzeile</h3>
            </div>
            <div class="card-body">
                {% if USERDATA.instance.instances_emailHeader != null %}
                    <img loading="lazy" src="{{ USERDATA.instance.instances_emailHeader|s3URL("medium") }}" style="width: 100%;">
                {% else %}
                    <i>Noch nicht hinterlegt</i>
                {% endif %}
            </div>
            {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
            <div class="card-footer">
                <b>Bilder für E-Mail-Kopfzeilen sind öffentlich abrufbar.</b>
                {% embed 'assets/templates/uppy.twig' with {'publicBool': true, 'type': 'INSTANCE-EMAILHEADER', 'paste': false, 'typeId': 10, 'subTypeId': USERDATA.instance.instances_id, 'fileLimit': 1, 'imagesOnly': true } %}
                    {% block success %}
                        ajaxcall("instances/editInstance.php", {
                        'formData': [{ 'name': 'instances_emailHeader','value':responseJson.id }]
                        }, function (data) {
                        location.reload();
                        });
                    {% endblock %}
                {% endembed %}
            </div>
            {% endif %}
        </div>
    </div>
    {% else %}
    <div class="col-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Dateiablage nicht verfügbar</h3>
            </div>
            <div class="card-body">
                <p>Aktiviere die Dateiablage für dein Unternehmen, um ein Logo oder ein Bild für die E-Mail-Kopfzeile zu hinterlegen.</p>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}